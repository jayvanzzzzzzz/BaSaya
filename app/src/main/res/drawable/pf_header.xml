<?xml version="1.0" encoding="utf-8"?>
<!-- Account header: the app violet, rounded on all sides, with a 3D lip and doodles. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tb_lip" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:endColor="@color/tb_end" android:startColor="@color/tb_start" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="6dp" android:drawable="@drawable/tb_decor" android:gravity="end|top" android:height="70dp" android:right="8dp" android:top="6dp" android:width="150dp" />
</layer-list>
