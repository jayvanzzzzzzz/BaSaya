<?xml version="1.0" encoding="utf-8"?>
<!-- Exit dialog card: a thick sticker with a soft lip underneath. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lex_card_lip" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lex_card" />
            <stroke
                android:width="2dp"
                android:color="@color/lex_card_stroke" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>
