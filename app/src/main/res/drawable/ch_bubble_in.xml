<?xml version="1.0" encoding="utf-8"?>
<!-- A classmate's bubble: white candy card, flat corner by the avatar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ch_lip" />
            <corners android:topLeftRadius="18dp" android:topRightRadius="18dp"
                android:bottomRightRadius="18dp" android:bottomLeftRadius="6dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ch_bubble_in" />
            <stroke android:width="1dp" android:color="@color/ch_line" />
            <corners android:topLeftRadius="18dp" android:topRightRadius="18dp"
                android:bottomRightRadius="18dp" android:bottomLeftRadius="6dp" />
        </shape>
    </item>
</layer-list>
