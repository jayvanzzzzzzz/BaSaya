<?xml version="1.0" encoding="utf-8"?>
<!-- The teacher's bubble: soft violet so it stands out from classmates. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ch_teacher_line" />
            <corners android:topLeftRadius="18dp" android:topRightRadius="18dp"
                android:bottomRightRadius="18dp" android:bottomLeftRadius="6dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ch_teacher_tint" />
            <stroke android:width="1dp" android:color="@color/ch_teacher_line" />
            <corners android:topLeftRadius="18dp" android:topRightRadius="18dp"
                android:bottomRightRadius="18dp" android:bottomLeftRadius="6dp" />
        </shape>
    </item>
</layer-list>
