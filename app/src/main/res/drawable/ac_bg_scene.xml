<?xml version="1.0" encoding="utf-8"?>
<!-- Mint "art desk" sky with doodles up top and a soft wave at the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/ac_bg_mid"
                android:endColor="@color/ac_bg_bottom"
                android:startColor="@color/ac_bg_top" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ac_bg_decor"
        android:gravity="top|fill_horizontal"
        android:height="280dp" />
    <item
        android:drawable="@drawable/ac_bg_wave"
        android:gravity="bottom|fill_horizontal"
        android:height="160dp" />
</layer-list>
