<?xml version="1.0" encoding="utf-8"?>
<!-- The (i) button in the chat header: soft square with a ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ch_teacher_line">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ch_bg" />
            <stroke android:width="1dp" android:color="@color/ch_line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
