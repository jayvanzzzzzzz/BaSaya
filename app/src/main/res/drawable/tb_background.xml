<?xml version="1.0" encoding="utf-8"?>
<!-- Top bar: sky-to-violet gradient with rounded bottom, a 3D lip, and faint doodles. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tb_lip" />
            <corners android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/tb_end"
                android:startColor="@color/tb_start" />
            <corners android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:drawable="@drawable/tb_decor"
        android:gravity="end|bottom"
        android:height="70dp"
        android:right="96dp"
        android:width="150dp" />
</layer-list>
