<?xml version="1.0" encoding="utf-8"?>
<!-- Diksiyonaryo search field: white pill with a soft lip, like the cards. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pg_card_lip" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pg_surface" />
            <stroke android:width="1dp" android:color="@color/pg_divider" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
