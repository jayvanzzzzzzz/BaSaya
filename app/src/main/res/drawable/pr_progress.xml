<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/pr_track" />
            <stroke android:width="2dp" android:color="@color/pr_white_lip" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress"
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:endColor="@color/pr_coral"
                    android:startColor="@color/pr_progress_start" />
                <corners android:radius="100dp" />
            </shape>
        </scale>
    </item>
</layer-list>
