<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft shadow -->
    <item
        android:left="1dp"
        android:top="2dp">

        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <solid android:color="#12000000"/>
        </shape>

    </item>

    <!-- Tape -->
    <item>

        <shape android:shape="rectangle">

            <corners android:radius="6dp"/>

            <gradient
                android:startColor="#F8E8A8"
                android:centerColor="#F5E09B"
                android:endColor="#F2DA91"
                android:angle="90"/>

            <stroke
                android:width="1dp"
                android:color="#22FFFFFF"/>

        </shape>

    </item>

    <!-- Top highlight -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="20dp">

        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <solid android:color="#22FFFFFF"/>
        </shape>

    </item>

</layer-list>