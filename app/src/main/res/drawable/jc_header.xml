<?xml version="1.0" encoding="utf-8"?>
<!-- Join class header: same sky-to-violet as the main top bar, with a deeper rounded bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tb_lip" />
            <corners android:bottomLeftRadius="36dp" android:bottomRightRadius="36dp" />
        </shape>
    </item>
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:endColor="@color/tb_end" android:startColor="@color/tb_start" />
            <corners android:bottomLeftRadius="36dp" android:bottomRightRadius="36dp" />
        </shape>
    </item>
    <item android:bottom="6dp" android:drawable="@drawable/tb_decor" android:gravity="end|top" android:height="70dp" android:top="40dp" android:right="12dp" android:width="150dp" />
</layer-list>
