<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="4dp">
        <shape>
            <solid
                android:color="@color/wi_line"/>
            <corners
                android:radius="18dp"/>
        </shape>
    </item>
    <item
        android:bottom="4dp">
        <shape>
            <solid
                android:color="@color/wi_surface"/>
            <stroke
                android:width="1dp"
                android:color="@color/wi_line"/>
            <corners
                android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
