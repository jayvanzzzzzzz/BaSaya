<?xml version="1.0" encoding="utf-8"?>
<!-- Last level complete "all done" button: same candy shape in green. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cw_done_lip" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item android:top="4dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/cw_done_bottom"
                        android:startColor="@color/cw_done_top" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item android:top="9dp" android:left="22dp" android:right="22dp" android:height="10dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cw_btn_shine" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cw_done_lip" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/cw_done_bottom"
                        android:startColor="@color/cw_done_top" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item android:top="5dp" android:left="22dp" android:right="22dp" android:height="10dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cw_btn_shine" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
