<?xml version="1.0" encoding="utf-8"?>
<!-- Unread notification: violet lip and outline so new ones stand out. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pg_unread_lip" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pg_unread_bg" />
            <stroke android:width="1.5dp" android:color="@color/pg_unread_stroke" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
