<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary chunky 3D button: light face with a gold outline, sinks onto its lip when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/qz_gold_lip" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/qz_surface" />
                    <stroke android:width="2dp" android:color="@color/qz_gold" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/qz_gold_lip" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/qz_surface" />
                    <stroke android:width="2dp" android:color="@color/qz_gold" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
