<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/home_accent_ripple">
    <item>
        <selector>
            <item
                android:state_selected="true">
                <layer-list>
                    <item>
                        <shape>
                            <solid
                                android:color="@color/home_accent_tint" />
                            <corners
                                android:topLeftRadius="8dp"
                                android:topRightRadius="8dp" />
                        </shape>
                    </item>
                    <item
                        android:height="2dp"
                        android:gravity="bottom">
                        <shape>
                            <solid
                                android:color="@color/home_accent" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <shape>
                    <solid
                        android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>