<?xml version="1.0" encoding="utf-8"?>
<!-- Lesson card: outline check in a ring, sized to match the download progress ring. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Ring -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M12,3A9,9 0,1 0,12,21A9,9 0,1 0,12,3"
        android:strokeColor="@color/lesson_downloaded_check"
        android:strokeWidth="2" />

    <!-- Check -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M8.25,12.25 L10.75,14.75 L15.75,9.5"
        android:strokeColor="@color/lesson_downloaded_check"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
