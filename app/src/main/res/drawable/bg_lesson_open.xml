<?xml version="1.0" encoding="utf-8"?>
<!-- Compact "Buksan" pill on the lesson card. Pressed state follows the parent card. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lesson_card_primary_pressed" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lesson_card_primary" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
