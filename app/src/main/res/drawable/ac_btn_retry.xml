<?xml version="1.0" encoding="utf-8"?>
<!-- Chunky 3D button: the face sinks onto its lip when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ac_disabled_lip" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ac_disabled" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ac_wrong_lip" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ac_wrong" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ac_wrong_lip" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ac_wrong" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
