<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item
        android:left="2dp"
        android:top="3dp">

        <shape android:shape="oval">
            <solid android:color="#26000000"/>
        </shape>

    </item>

    <!-- Main button -->
    <item>

        <shape android:shape="oval">

            <gradient
                android:startColor="#6A5AF9"
                android:endColor="#5445F3"
                android:angle="270"/>

            <stroke
                android:width="2dp"
                android:color="#8478FF"/>

        </shape>

    </item>

    <!-- Inner ring -->
    <item
        android:left="7dp"
        android:right="7dp"
        android:top="7dp"
        android:bottom="7dp">

        <shape android:shape="oval">

            <stroke
                android:width="2dp"
                android:color="#22FFFFFF"/>

        </shape>

    </item>

</layer-list>