<?xml version="1.0" encoding="utf-8"?>
<!-- Account screen info rows. -->
<resources>

    <style name="Pf.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Pf.RowIcon" parent="">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/pg_circle</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="Pf.RowTexts" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Pf.RowLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/quicksand_medium</item>
        <item name="android:textColor">@color/pg_ink_soft</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Pf.RowValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textColor">@color/pg_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Pf.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/tb_end</item>
        <item name="hintTextColor">@color/tb_end</item>
    </style>

    <style name="Pf.InputText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/pg_ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Pf.GenderChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/be_vietnam_bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Pf.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">56dp</item>
        <item name="android:background">@drawable/pf_divider</item>
    </style>
    <!-- One segment of the System / Light / Dark picker -->
    <style name="Pf.ThemeOption" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/be_vietnam_bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pf_theme_option_text</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/pf_theme_option_bg</item>
        <item name="strokeColor">@color/pg_divider</item>
        <item name="strokeWidth">1.5dp</item>
    </style>
</resources>
