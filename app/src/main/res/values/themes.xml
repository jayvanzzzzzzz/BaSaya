<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (light). Dark colors live in values-night/themes.xml. -->
    <style name="Base.Theme.BaSaya" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Shared by light and dark, so it stays out of the night override above. -->
    <style name="Theme.BaSaya" parent="Base.Theme.BaSaya">
        <item name="android:fontFamily">@font/be_vietnam_regular</item>
        <item name="fontFamily">@font/be_vietnam_regular</item>
    </style>

    <!-- Launch screen: the window starts in the splash sky color so SplashActivity fades in seamlessly.
         Android 12+ adds its system splash attributes in values-v31/themes.xml. -->
    <style name="Theme.BaSaya.Splash">
        <item name="android:windowBackground">@color/splash_bg_top</item>
    </style>
</resources>
