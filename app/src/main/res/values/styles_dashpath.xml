<?xml version="1.0" encoding="utf-8"?>
<!-- Lesson notebook: quiet numbered margin, opening lecture, compact practice entries. -->
<resources>

    <style name="Dl.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <!-- A quiet notebook margin; numbers follow teacher-selected parts. -->
    <style name="Dl.Rail" parent="">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:clipChildren">false</item>
        <item name="android:importantForAccessibility">noHideDescendants</item>
    </style>

    <style name="Dl.Trail" parent="">
        <item name="android:layout_width">3dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:background">@color/dash_divider</item>
    </style>

    <style name="Dl.Step" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">top|center_horizontal</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:background">@drawable/quest_step</item>
        <item name="android:elevation">0dp</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/dash_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Dl.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardBackgroundColor">@color/dash_surface</item>
        <item name="cardCornerRadius">@dimen/dash_radius_m</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@animator/dashboard_press</item>
    </style>

    <style name="Dl.CardBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Dl.Icon" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:padding">2dp</item>
    </style>

    <style name="Dl.Texts" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Dl.Title" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textColor">@color/dash_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Dl.Sub" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/be_vietnam_regular</item>
        <item name="android:textColor">@color/dash_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Dl.Meta" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="alignItems">center</item>
        <item name="flexWrap">wrap</item>
    </style>

    <style name="Dl.Count" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:text">@string/lesson_dash_count_placeholder</item>
        <item name="android:textColor">@color/dash_text_secondary</item>
        <item name="android:fontFamily">@font/be_vietnam_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Completion pill (LinearLayout root; shown by DashboardActivity) -->
    <style name="Dl.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_dashboard_done</item>
        <item name="android:contentDescription">@string/lesson_dash_done</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Dl.BadgeIcon" parent="">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_check</item>
        <item name="tint">@color/dash_done_fg</item>
    </style>

    <style name="Dl.BadgeText" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:fontFamily">@font/be_vietnam_bold</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:text">@string/lesson_dash_done</item>
        <item name="android:textColor">@color/dash_done_fg</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Dl.Play" parent="">
 <item name="android:layout_width">24dp</item><item name="android:layout_height">24dp</item>
 <item name="android:layout_gravity">center</item><item name="android:importantForAccessibility">no</item>
 <item name="android:src">@drawable/ic_chevron_right</item><item name="tint">@color/dash_lecture</item>
 </style>
</resources>
