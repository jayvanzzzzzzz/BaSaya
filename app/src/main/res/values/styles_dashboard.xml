<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Lesson dashboard (activity_dashboard.xml) text styles.
         Applied with style="@style/..." (not android:textAppearance) so that
         letterSpacing / lineSpacingExtra are honoured on all API levels >= 24.
         parent="" stops the dotted names from implying a non-existent parent. -->
    <style name="TextAppearance.Dash.Eyebrow" parent="">
        <item name="android:fontFamily">@font/quicksand_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/dash_text_eyebrow</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/dash_sage</item>
    </style>

    <style name="TextAppearance.Dash.Title" parent="">
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/dash_text_title</item>
        <item name="android:textColor">@color/dash_text_primary</item>
    </style>

    <style name="TextAppearance.Dash.Desc" parent="">
        <item name="android:fontFamily">@font/quicksand_medium</item>
        <item name="android:textSize">@dimen/dash_text_desc</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/dash_text_secondary</item>
    </style>

    <style name="TextAppearance.Dash.Section" parent="">
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/dash_text_section</item>
        <item name="android:textColor">@color/dash_text_primary</item>
    </style>

    <style name="TextAppearance.Dash.CardTitle" parent="">
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/dash_text_card_title</item>
        <item name="android:textColor">@color/dash_text_primary</item>
    </style>

    <style name="TextAppearance.Dash.CardTitleHero" parent="TextAppearance.Dash.CardTitle">
        <item name="android:textSize">@dimen/dash_text_card_title_hero</item>
    </style>

    <style name="TextAppearance.Dash.CardSub" parent="">
        <item name="android:fontFamily">@font/quicksand_medium</item>
        <item name="android:textSize">@dimen/dash_text_card_sub</item>
        <item name="android:textColor">@color/dash_text_secondary</item>
    </style>

    <!-- Count badge; colour and background tint are set per card in the layout. -->
    <style name="TextAppearance.Dash.Badge" parent="">
        <item name="android:fontFamily">@font/quicksand_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/dash_text_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/dash_badge_min_height</item>
        <item name="android:paddingStart">@dimen/dash_badge_padding_h</item>
        <item name="android:paddingEnd">@dimen/dash_badge_padding_h</item>
        <item name="android:paddingTop">@dimen/dash_badge_padding_v</item>
        <item name="android:paddingBottom">@dimen/dash_badge_padding_v</item>
        <item name="android:background">@drawable/bg_dashboard_count</item>
    </style>

    <style name="TextAppearance.Dash.Pill" parent="">
        <item name="android:fontFamily">@font/quicksand_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/dash_text_pill</item>
        <item name="android:textColor">@color/dash_done_fg</item>
    </style>

    <style name="Widget.Dash.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/dash_surface</item>
        <item name="cardCornerRadius">@dimen/dash_radius_l</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/dash_stroke</item>
        <item name="strokeWidth">@dimen/dash_stroke</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <!-- Keep cards flat so the quiz lock overlay always stays on top. -->
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
