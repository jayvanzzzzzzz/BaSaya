<resources>
    <style name="HomeFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:fontFamily">@font/be_vietnam_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/home_filter_chip_text</item>
        <item name="chipBackgroundColor">@color/home_filter_chip_bg</item>
        <item name="chipStrokeColor">@color/home_filter_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">@color/home_accent_ripple</item>
    </style>
</resources>
