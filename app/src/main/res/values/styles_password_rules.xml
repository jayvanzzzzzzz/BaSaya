<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One line of the password checklist (view_password_rules.xml) -->
    <style name="PasswordRuleItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:drawableStart">@drawable/ic_rule_pending</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/pw_rule_pending</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
