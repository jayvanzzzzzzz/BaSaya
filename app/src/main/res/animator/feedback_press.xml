<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><set><objectAnimator android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" android:duration="120"/><objectAnimator android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" android:duration="120"/></set></item>
    <item><set android:interpolator="@android:interpolator/overshoot"><objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:duration="180"/><objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:duration="180"/></set></item>
</selector>
