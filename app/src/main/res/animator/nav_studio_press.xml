<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><set android:ordering="together">
        <objectAnimator android:propertyName="scaleX" android:valueTo="0.96" android:duration="120" android:valueType="floatType"/>
        <objectAnimator android:propertyName="scaleY" android:valueTo="0.96" android:duration="120" android:valueType="floatType"/>
    </set></item>
    <item><set android:ordering="together">
        <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="180" android:valueType="floatType"/>
        <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="180" android:valueType="floatType"/>
    </set></item>
</selector>
