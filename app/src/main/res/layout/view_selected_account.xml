<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/selectedAccountPanel"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
    android:layout_marginBottom="16dp" android:visibility="gone">
    <TextView android:id="@+id/selectedAccountAvatar" android:layout_width="56dp" android:layout_height="56dp"
        android:gravity="center" android:importantForAccessibility="no" android:background="@drawable/bg_recent_account_avatar"
        android:textColor="?attr/colorOnPrimaryContainer" android:textAppearance="@style/TextAppearance.BaSaya.Login.Button" />
    <TextView android:id="@+id/selectedAccountName" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:layout_marginStart="12dp"
        android:textColor="?attr/colorOnSurface" android:textAppearance="@style/TextAppearance.BaSaya.Login.Button" />
</LinearLayout>
