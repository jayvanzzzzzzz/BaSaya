<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_semi_bold"
            android:letterSpacing="0.12"
            android:text="@string/account_menu_heading"
            android:textColor="@color/account_menu_body"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/accountMenuInitial"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_account_menu_avatar"
                android:fontFamily="@font/be_vietnam_semi_bold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/account_menu_accent"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/accountMenuName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/be_vietnam_semi_bold"
                    android:maxLines="2"
                    android:textColor="@color/account_menu_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/accountMenuEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="middle"
                    android:fontFamily="@font/be_vietnam_regular"
                    android:maxLines="1"
                    android:textColor="@color/account_menu_body"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@color/account_menu_border"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/accountMenuLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_account_menu_action"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:padding="14dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/pf_ic_logout"
            android:tint="@color/account_menu_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_semi_bold"
                android:text="@string/pf_logout"
                android:textColor="@color/account_menu_title"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/be_vietnam_regular"
                android:text="@string/account_menu_logout_hint"
                android:textColor="@color/account_menu_body"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/account_menu_body" />
    </LinearLayout>
</LinearLayout>
