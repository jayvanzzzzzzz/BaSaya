<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="@drawable/bg_app_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivDialogIcon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/lexend"
        android:textColor="#25231D"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="@font/quicksand_medium"
        android:lineSpacingExtra="3dp"
        android:textColor="#6B675D"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogPrimary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/quicksand_medium"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="#315EAE"
        app:cornerRadius="15dp" />

    <TextView
        android:id="@+id/btnDialogSecondary"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:fontFamily="@font/quicksand_medium"
        android:textColor="#5F5A50"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>