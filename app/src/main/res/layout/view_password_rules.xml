<?xml version="1.0" encoding="utf-8"?>
<!-- Checklist under a new-password field; PasswordRule.watch() ticks each rule as it's met. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/passwordRules"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/ruleLength"
        style="@style/PasswordRuleItem"
        android:text="@string/password_rule_length" />

    <TextView
        android:id="@+id/ruleLower"
        style="@style/PasswordRuleItem"
        android:text="@string/password_rule_lower" />

    <TextView
        android:id="@+id/ruleUpper"
        style="@style/PasswordRuleItem"
        android:text="@string/password_rule_upper" />

    <TextView
        android:id="@+id/ruleNumber"
        style="@style/PasswordRuleItem"
        android:text="@string/password_rule_number" />
</LinearLayout>
