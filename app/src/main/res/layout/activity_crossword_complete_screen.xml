<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cw_bg_scene"
    tools:context=".ui.game.CrosswordCompleteScreen">

    <View
        android:id="@+id/dimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvLessonTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:textColor="@color/white"

        android:text="Lesson Title"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="70dp"
        android:fontFamily="@font/lexend"
        android:textStyle="italic|bold"

        android:textSize="40sp"/>

    <LinearLayout
        android:id="@+id/currentLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toBottomOf="@id/tvLessonTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:orientation="vertical"

        android:layout_marginTop="50dp"
        android:background="@drawable/level_background"
        android:padding="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level"
            android:layout_gravity="center"
            android:fontFamily="@font/lexend"
            android:textStyle="bold"

            android:textColor="@color/white"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/tvLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="...."
            android:layout_gravity="center"

            android:textColor="@color/white"
            android:textSize="20sp"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:max="3"
        android:progress="1"
        android:progressDrawable="@drawable/progress_bar_drawable"

        android:layout_marginTop="50dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"

        app:layout_constraintTop_toBottomOf="@id/currentLevel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 / 3"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:gravity="center"

        app:layout_constraintTop_toTopOf="@id/progressBar"
        app:layout_constraintBottom_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="@id/progressBar" />

    <!-- Chunky candy button (orange "next level" / green "all done", set in code). Pops in, then breathes. -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="70dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/cw_btn_next"
        android:drawableEnd="@drawable/ic_lesson_chevron"
        android:drawablePadding="10dp"
        android:fontFamily="@font/lexend"
        android:gravity="center"
        android:minWidth="240dp"
        android:paddingStart="34dp"
        android:paddingTop="0dp"
        android:paddingEnd="28dp"
        android:paddingBottom="6dp"
        android:shadowColor="@color/cw_btn_text_shadow"
        android:shadowDy="3"
        android:shadowRadius="1"
        android:stateListAnimator="@null"
        android:text="@string/cw_next_level"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="21sp"
        android:textStyle="bold"
        app:drawableTint="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

    <!-- Practice lesson, last level: nothing was saved, and the game can be played again.
         Offline, it says the level was saved on the phone instead. -->
    <TextView
        android:id="@+id/tvPracticeNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/quicksand_medium"
        android:gravity="center"
        android:text="@string/practice_not_saved"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnNext" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReplay"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/cw_btn_next"
        android:fontFamily="@font/lexend"
        android:gravity="center"
        android:minWidth="200dp"
        android:paddingStart="28dp"
        android:paddingTop="0dp"
        android:paddingEnd="28dp"
        android:paddingBottom="6dp"
        android:stateListAnimator="@null"
        android:text="@string/practice_play_again"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPracticeNote" />

</androidx.constraintlayout.widget.ConstraintLayout>