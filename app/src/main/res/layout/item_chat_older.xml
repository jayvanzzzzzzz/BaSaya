<?xml version="1.0" encoding="utf-8"?>
<!-- "Tingnan ang mas luma": loads the previous page of messages. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/btnOlder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/ch_pill"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_semi_bold"
        android:gravity="center"
        android:minHeight="40dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/ch_older"
        android:textColor="@color/nav_tab_chat"
        android:textSize="13sp" />
</FrameLayout>
