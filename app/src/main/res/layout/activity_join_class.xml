<?xml version="1.0" encoding="utf-8"?>
<!-- Join class: violet header with the book buddy, account card, big class-code box, gold button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tb_page_bg"
    tools:context=".ui.JoinClassActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ═══ Header (top padding = status bar, set in code) ═══ -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/jc_header"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/tb_glass"
                    android:contentDescription="@string/close"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    app:tint="@color/tb_on" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/lexend"
                    android:text="@string/jc_title"
                    android:textColor="@color/tb_on"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Buddy + speech bubble with the instruction -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.basaya.ui.pronunciation.PronunciationBookView
                    android:id="@+id/buddy"
                    android:layout_width="104dp"
                    android:layout_height="122dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/jc_bubble"
                    android:elevation="3dp"
                    android:fontFamily="@font/quicksand_medium"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:text="@string/join_class_instruction"
                    android:textColor="@color/pg_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Body ═══ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <!-- Signed-in account -->
                <LinearLayout
                    android:id="@+id/signedInAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pg_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="19dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_medium"
                        android:text="@string/signed_in_as"
                        android:textColor="@color/pg_ink_soft"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAvatar"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/tb_avatar"
                            android:contentDescription="@string/profile_photo"
                            android:fontFamily="@font/lexend"
                            android:gravity="center"
                            android:text="B"
                            android:textColor="@color/tb_avatar_ink"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvFullName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/lexend"
                                android:maxLines="1"
                                android:textColor="@color/pg_ink"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="Juan Dela Cruz" />

                            <TextView
                                android:id="@+id/tvEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/quicksand_medium"
                                android:maxLines="1"
                                android:textColor="@color/pg_ink_soft"
                                android:textSize="14sp"
                                tools:text="juan@gmail.com" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Class code -->
                <LinearLayout
                    android:id="@+id/codeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/pg_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="19dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/lexend"
                        android:gravity="center_vertical"
                        android:labelFor="@id/etClassCode"
                        android:text="@string/jc_code_label"
                        android:textColor="@color/pg_ink"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_lock_small"
                        app:drawableTint="@color/tb_end" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilClassCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/jc_code_hint"
                        android:textColorHint="@color/pg_ink_soft"
                        app:boxBackgroundColor="#F4F2FF"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="18dp"
                        app:boxCornerRadiusBottomStart="18dp"
                        app:boxCornerRadiusTopEnd="18dp"
                        app:boxCornerRadiusTopStart="18dp"
                        app:boxStrokeColor="@color/tb_end"
                        app:boxStrokeWidth="2dp"
                        app:boxStrokeWidthFocused="3dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etClassCode"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:autofillHints=""
                            android:fontFamily="@font/lexend"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:letterSpacing="0.2"
                            android:maxLines="1"
                            android:textColor="@color/pg_ink"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ═══ Join ═══ -->
        <TextView
            android:id="@+id/btnJoin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/qz_btn_next"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_bold"
            android:gravity="center"
            android:paddingBottom="5dp"
            android:text="@string/join"
            android:textColor="@color/qz_btn_text"
            android:textSize="18sp" />
    </LinearLayout>

    <com.example.basaya.ui.game.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="16dp" />
</FrameLayout>
