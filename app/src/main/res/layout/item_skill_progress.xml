<?xml version="1.0" encoding="utf-8"?>
<!-- One skill on the student's progress screen. Colors and values are set in ProgressFragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/pg_card"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="21dp">

    <!-- Icon · name · stars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivSkillIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/pg_circle"
            android:importantForAccessibility="no"
            android:padding="13dp"
            tools:src="@drawable/ic_mic" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSkillName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lexend"
                android:textColor="@color/pg_ink"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Pagbigkas" />

            <TextView
                android:id="@+id/tvSkillSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_medium"
                android:textColor="@color/pg_ink_soft"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Pronunciation" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/starsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/star1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:rotation="-10"
                android:importantForAccessibility="no"
                android:src="@drawable/cw_ic_star" />

            <ImageView
                android:id="@+id/star2"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cw_ic_star" />

            <ImageView
                android:id="@+id/star3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:rotation="10"
                android:importantForAccessibility="no"
                android:src="@drawable/cw_ic_star" />
        </LinearLayout>
    </LinearLayout>

    <!-- Score bar · percent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/scoreTrack"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:background="@drawable/pg_round"
            android:backgroundTint="@color/pg_track">

            <View
                android:id="@+id/scoreFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/pg_round" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSkillPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/lexend"
            android:minWidth="52dp"
            android:gravity="end"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="71" />
    </LinearLayout>

    <!-- Level · trend · mini chart of each lesson -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSkillLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pg_round"
            android:fontFamily="@font/be_vietnam_bold"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textSize="12sp"
            tools:text="Umuunlad" />

        <TextView
            android:id="@+id/tvSkillTrend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/pg_round"
            android:fontFamily="@font/be_vietnam_bold"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="↑ Umaangat"
            tools:visibility="visible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/lessonBars"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="bottom"
            android:importantForAccessibility="no"
            android:orientation="horizontal" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSkillMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/quicksand_medium"
        android:textColor="@color/pg_ink_soft"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Malapit ka na! Kaunting ensayo pa." />
</LinearLayout>
