<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the learning report. Scores, levels, trends and stars stay separate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <View
            android:id="@+id/skillAccent"
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pg_bar"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/ivSkillIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/ps_icon"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_mic" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvSkillName"
                style="@style/Ps.Section"
                android:textSize="18sp"
                tools:text="Pag-unawa sa Binasa" />
            <TextView
                android:id="@+id/tvSkillSource"
                style="@style/Ps.Body"
                android:textSize="12sp"
                android:layout_marginTop="3dp"
                tools:text="Pagsusulit" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/scoreTrack"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:background="@drawable/pg_bar"
            android:backgroundTint="@color/ps_track"
            android:importantForAccessibility="noHideDescendants">
            <View
                android:id="@+id/scoreFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/pg_bar" />
        </FrameLayout>
        <TextView
            android:id="@+id/tvSkillPercent"
            style="@style/Ps.Section"
            android:accessibilityHeading="false"
            android:layout_width="wrap_content"
            android:layout_marginStart="16dp"
            android:textSize="28sp"
            tools:text="71" />
    </LinearLayout>
    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:flexWrap="wrap"
        app:alignItems="center">
        <TextView
            android:id="@+id/tvSkillLevel"
            style="@style/Ps.Label"
            tools:text="Kailangan ng tulong" />
        <TextView
            android:id="@+id/tvSkillTrend"
            style="@style/Ps.Label"
            android:visibility="gone"
            tools:text="↑ Umaangat"
            tools:visibility="visible" />
        <LinearLayout
            android:id="@+id/starsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/star1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/cw_ic_star"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/star2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/cw_ic_star"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/star3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/cw_ic_star"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </com.google.android.flexbox.FlexboxLayout>
    <TextView
        android:id="@+id/tvSkillMessage"
        style="@style/Ps.Body"
        android:layout_marginTop="8dp"
        tools:text="Malapit ka na! Kaunting ensayo pa." />
    <LinearLayout
        android:id="@+id/lessonHistoryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/Ps.Body"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/ps_recent_lessons"
            android:textSize="11sp"
            android:layout_marginEnd="12dp" />
        <LinearLayout
            android:id="@+id/lessonBars"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="bottom"
            android:importantForAccessibility="no"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>