<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    tools:context=".ui.fragment.HomeFragment">

    <LinearLayout
        android:id="@+id/topSectionWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F8FC"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="13dp"
            android:autofillHints="name"
            android:background="@drawable/bg_dashboard_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="@string/maghanap_dito_ng_paksa"
            android:inputType="text"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="#26334D"
            android:textColorHint="#778199"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvClassName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dashboard_class"
        android:drawableStart="@drawable/ic_book"
        android:drawablePadding="7dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:textColor="#356547"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topSectionWrapper"
        tools:text="Masayang Pagbasa" />

    <TextView
        android:id="@+id/tvSectionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/lexend"
        android:text="@string/dashboard_lessons_title"
        android:textColor="#26334D"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnRefresh"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvClassName" />

    <ImageButton
        android:id="@+id/btnRefresh"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_dashboard_refresh"
        android:contentDescription="@string/refresh_lessons"
        android:padding="10dp"
        android:src="@drawable/ic_refresh"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvClassName"
        app:tint="#5374BD" />

    <!-- Bottom edge of the section header row (the refresh button is taller than the label) -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/sectionHeaderBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvSectionLabel,btnRefresh" />

    <!-- Lahat / Bukas / Sarado. Shown once the class has lessons. -->
    <LinearLayout
        android:id="@+id/lessonTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_lesson_tabs"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sectionHeaderBottom"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tabAll"
            style="@style/LessonTab"
            tools:text="Lahat (5)" />

        <TextView
            android:id="@+id/tabOpen"
            style="@style/LessonTab"
            android:layout_marginStart="4dp"
            tools:text="Bukas (3)" />

        <TextView
            android:id="@+id/tabClosed"
            style="@style/LessonTab"
            android:layout_marginStart="4dp"
            tools:text="Sarado (2)" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLessons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lessonTabs"
        tools:listitem="@layout/item_lesson" />

    <ImageButton
        android:id="@+id/btnJoinClass"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_join_class_action"
        android:contentDescription="@string/cta_add_class_description"
        android:elevation="8dp"
        android:padding="15dp"
        android:src="@drawable/ic_join_class"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#FFFFFF" />

    <!--
      Empty state lives in its own scroll area below the header: centered when it fits,
      scrollable when the screen is short, so the message is never clipped and never
      overlaps the section label or refresh button. Shown/hidden with tvEmptyLessons.
    -->
    <ScrollView
        android:id="@+id/emptyStateScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="16dp"
        android:paddingBottom="88dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lessonTabs">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvEmptyLessons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="34dp"
                android:layout_marginEnd="34dp"
                android:background="@drawable/bg_home_empty_state"
                android:drawableTop="@drawable/ic_empty_lessons"
                android:drawablePadding="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="24dp"
                android:text="@string/empty_no_lessons"
                android:textColor="#59647A"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sectionHeaderBottom">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <View
                android:id="@+id/dot1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/dot_circle" />

            <View
                android:id="@+id/dot2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/dot_circle" />

            <View
                android:id="@+id/dot3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_circle" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/dashboard_loading_lessons"
            android:textColor="#69758D"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
