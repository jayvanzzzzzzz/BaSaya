<?xml version="1.0" encoding="utf-8"?>
<!-- Account: violet header, editable student info, password change, logout. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tb_page_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.fragment.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- ═══ Header ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pf_header"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <TextView
                android:id="@+id/pfAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/tb_avatar"
                android:contentDescription="@string/profile_picture"
                android:fontFamily="@font/lexend"
                android:gravity="center"
                android:textColor="@color/tb_avatar_ink"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="J" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pfName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/tb_on"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Juan Dela Cruz" />

                <!-- Email (read-only) -->
                <TextView
                    android:id="@+id/pfEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/quicksand_medium"
                    android:maxLines="1"
                    android:textColor="@color/tb_on_soft"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="juan@gmail.com" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ My info ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="@font/lexend"
                android:text="@string/pf_section_info"
                android:textColor="@color/pg_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/pg_round"
                android:backgroundTint="@color/pg_unawa_tint"
                android:clickable="true"
                android:contentDescription="@string/pf_edit_cd"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:fontFamily="@font/be_vietnam_bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="@string/pf_edit"
                android:textColor="@color/pg_unawa"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ac_ic_pencil"
                app:drawableTint="@color/pg_unawa" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="11dp">

            <!-- Name -->
            <LinearLayout style="@style/Pf.Row">

                <ImageView
                    style="@style/Pf.RowIcon"
                    android:backgroundTint="@color/pg_unawa_tint"
                    android:src="@drawable/pf_ic_person"
                    app:tint="@color/pg_unawa" />

                <LinearLayout style="@style/Pf.RowTexts">

                    <TextView style="@style/Pf.RowLabel" android:text="@string/pf_name" />

                    <TextView
                        android:id="@+id/pfInfoName"
                        style="@style/Pf.RowValue"
                        tools:text="Juan Santos Dela Cruz" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Pf.Divider" />

            <!-- Gender -->
            <LinearLayout style="@style/Pf.Row">

                <ImageView
                    style="@style/Pf.RowIcon"
                    android:backgroundTint="@color/pg_pagkilala_tint"
                    android:src="@drawable/pf_ic_gender"
                    app:tint="@color/pg_pagkilala" />

                <LinearLayout style="@style/Pf.RowTexts">

                    <TextView style="@style/Pf.RowLabel" android:text="@string/pf_gender" />

                    <TextView
                        android:id="@+id/pfInfoGender"
                        style="@style/Pf.RowValue"
                        tools:text="Lalaki" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Pf.Divider" />

            <!-- Birthday -->
            <LinearLayout style="@style/Pf.Row">

                <ImageView
                    style="@style/Pf.RowIcon"
                    android:backgroundTint="@color/pg_pagbigkas_tint"
                    android:src="@drawable/pf_ic_calendar"
                    app:tint="@color/pg_pagbigkas" />

                <LinearLayout style="@style/Pf.RowTexts">

                    <TextView style="@style/Pf.RowLabel" android:text="@string/pf_birthday" />

                    <TextView
                        android:id="@+id/pfInfoBirthday"
                        style="@style/Pf.RowValue"
                        tools:text="Oktubre 12, 2016" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ My class: leaving needs the teacher's approval ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/lexend"
            android:text="@string/pf_section_class"
            android:textColor="@color/pg_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:background="@drawable/pg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="11dp">

            <!-- Current class -->
            <LinearLayout style="@style/Pf.Row">

                <ImageView
                    style="@style/Pf.RowIcon"
                    android:backgroundTint="@color/pg_pagsusulit_tint"
                    android:src="@drawable/pf_ic_class"
                    app:tint="@color/pg_pagsusulit" />

                <LinearLayout style="@style/Pf.RowTexts">

                    <TextView
                        android:id="@+id/pfClassLabel"
                        style="@style/Pf.RowLabel"
                        android:text="@string/pf_class_current" />

                    <TextView
                        android:id="@+id/pfClassName"
                        style="@style/Pf.RowValue"
                        tools:text="Grade 8 - Aguinaldo" />
                </LinearLayout>
            </LinearLayout>

            <!-- Waiting for the teacher / the teacher said no -->
            <LinearLayout
                android:id="@+id/pfLeaveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/pf_status_pending"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/pfLeaveStatusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend"
                    android:textColor="@color/pg_ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Hinihintay ang iyong guro" />

                <TextView
                    android:id="@+id/pfLeaveStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/quicksand_medium"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/pg_ink_soft"
                    android:textSize="13sp"
                    tools:text="Humiling kang umalis sa klase." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLeaveStatusAction"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/be_vietnam_bold"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    tools:text="Kanselahin ang paghiling" />
            </LinearLayout>

            <View
                android:id="@+id/pfLeaveDivider"
                style="@style/Pf.Divider" />

            <!-- Leave the class -->
            <LinearLayout
                android:id="@+id/rowLeaveClass"
                style="@style/Pf.Row"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/Pf.RowIcon"
                    android:backgroundTint="#FDECEC"
                    android:src="@drawable/pf_ic_logout"
                    app:tint="#D64545" />

                <LinearLayout style="@style/Pf.RowTexts">

                    <TextView
                        style="@style/Pf.RowValue"
                        android:layout_marginTop="0dp"
                        android:text="@string/pf_leave_class"
                        android:textColor="#D64545" />

                    <TextView
                        style="@style/Pf.RowLabel"
                        android:layout_marginTop="2dp"
                        android:text="@string/pf_leave_class_sub" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/pg_ink_soft" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Security ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/lexend"
            android:text="@string/pf_section_security"
            android:textColor="@color/pg_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rowChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="19dp">

            <ImageView
                style="@style/Pf.RowIcon"
                android:backgroundTint="@color/pg_talasalitaan_tint"
                android:src="@drawable/pf_ic_key"
                app:tint="@color/pg_talasalitaan" />

            <LinearLayout style="@style/Pf.RowTexts">

                <TextView
                    style="@style/Pf.RowValue"
                    android:layout_marginTop="0dp"
                    android:text="@string/pf_change_password" />

                <TextView
                    style="@style/Pf.RowLabel"
                    android:layout_marginTop="2dp"
                    android:text="@string/pf_change_password_sub" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/pg_ink_soft" />
        </LinearLayout>

        <!-- ═══ Logout ═══ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/be_vietnam_bold"
            android:text="@string/pf_logout"
            android:textAllCaps="false"
            android:textColor="#D64545"
            android:textSize="16sp"
            app:cornerRadius="18dp"
            app:icon="@drawable/pf_ic_logout"
            app:iconGravity="textStart"
            app:iconTint="#D64545"
            app:strokeColor="#F2B8B8"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/pfVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/quicksand_medium"
            android:gravity="center"
            android:textColor="@color/pg_ink_soft"
            android:textSize="12sp"
            tools:text="BaSaya v1.0" />
    </LinearLayout>
</ScrollView>
