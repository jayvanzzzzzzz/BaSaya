<?xml version="1.0" encoding="utf-8"?>
<!-- Class chat: header card, messages, closed banner and composer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ch_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:context=".ui.fragment.ChatFragment">

    <!-- ═══ Header: class tile + title + class name / open-closed subtitle ═══ -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ch_header"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvClassTile"
            android:layout_width="48dp"
            android:layout_height="51dp"
            android:background="@drawable/ch_class_tile"
            android:fontFamily="@font/lexend"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="G4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="@font/lexend"
                android:maxLines="1"
                android:text="@string/ch_title"
                android:textColor="@color/ch_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatClass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_semi_bold"
                android:maxLines="1"
                android:textColor="@color/nav_tab_chat"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Grade 4 - Sampaguita"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvChatSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/quicksand_medium"
                android:maxLines="2"
                android:text="@string/ch_subtitle_open"
                android:textColor="@color/ch_ink_soft"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Class members: teacher on top, students A–Z (sheet_class_members). -->
        <ImageButton
            android:id="@+id/btnMembers"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ch_info_button"
            android:contentDescription="@string/ch_members"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info"
            android:tooltipText="@string/ch_members"
            android:visibility="gone"
            app:tint="@color/ch_ink_soft"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- ═══ Messages, or the empty / no-class / loading state ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/chatEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivEmptyIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/ch_pill"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_chat"
                app:tint="@color/nav_tab_chat" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/lexend"
                android:gravity="center"
                android:text="@string/ch_empty_title"
                android:textColor="@color/ch_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/quicksand_medium"
                android:gravity="center"
                android:text="@string/ch_empty_body"
                android:textColor="@color/ch_ink_soft"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/chatLoading"
            style="?android:attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/nav_tab_chat"
            android:visibility="gone" />

        <!-- "Go to newest": shown once scrolled up, with a count of messages that came in meanwhile. -->
        <FrameLayout
            android:id="@+id/jumpToNewest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btnJumpToNewest"
                android:layout_width="44dp"
                android:layout_height="46dp"
                android:background="@drawable/ch_jump"
                android:contentDescription="@string/ch_jump"
                android:elevation="3dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chat_down"
                app:tint="@color/ch_ink_soft" />

            <TextView
                android:id="@+id/tvJumpCount"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="-4dp"
                android:background="@drawable/ch_jump_badge"
                android:elevation="4dp"
                android:fontFamily="@font/lexend"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />
        </FrameLayout>
    </FrameLayout>

    <!-- ═══ Closed by the teacher: read only ═══ -->
    <TextView
        android:id="@+id/tvClosedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/ch_closed_banner"
        android:fontFamily="@font/be_vietnam_semi_bold"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/ch_closed_banner"
        android:textColor="@color/ch_closed"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- ═══ Composer ═══ -->
    <LinearLayout
        android:id="@+id/chatComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ch_composer">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="@font/be_vietnam_regular"
                android:hint="@string/ch_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="300"
                android:maxLines="5"
                android:minHeight="48dp"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:textColor="@color/ch_ink"
                android:textColorHint="@color/ch_ink_soft"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="14dp"
                android:fontFamily="@font/be_vietnam_semi_bold"
                android:importantForAccessibility="no"
                android:textColor="@color/ch_ink_soft"
                android:textSize="10sp"
                android:visibility="gone"
                tools:ignore="SmallSp"
                tools:text="256/300"
                tools:visibility="visible" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="51dp"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ch_send"
                android:contentDescription="@string/ch_send"
                android:enabled="false"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send" />

            <!-- Seconds left before the next send (5-second limit). -->
            <TextView
                android:id="@+id/tvCooldown"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/lexend"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="4" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
