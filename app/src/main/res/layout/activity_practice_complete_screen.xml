<?xml version="1.0" encoding="utf-8"?>
<!-- Practice complete: the book buddy celebrates, stars pop in, and the score counts up. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ac_bg_scene"
    tools:context=".ui.activity.PracticeCompleteScreen">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvDoneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend"
                    android:gravity="center"
                    android:text="@string/ac_done_title"
                    android:textColor="@color/ac_ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActivityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ac_chip"
                    android:fontFamily="@font/be_vietnam_bold"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="9dp"
                    android:textColor="@color/ac_ink_soft"
                    android:textSize="14sp"
                    tools:text="Hanapin ang Pangngalan" />

                <ph.basaya.app.ui.pronunciation.PronunciationBookView
                    android:id="@+id/buddy"
                    android:layout_width="150dp"
                    android:layout_height="176dp"
                    android:layout_marginTop="12dp"
                    android:importantForAccessibility="no" />

                <!-- Stars earned -->
                <LinearLayout
                    android:id="@+id/starsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/star1"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:importantForAccessibility="no"
                        android:rotation="-12"
                        android:src="@drawable/cw_ic_star"
                        app:tint="@color/ac_star_off" />

                    <ImageView
                        android:id="@+id/star2"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/cw_ic_star"
                        app:tint="@color/ac_star_off" />

                    <ImageView
                        android:id="@+id/star3"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:importantForAccessibility="no"
                        android:rotation="12"
                        android:src="@drawable/cw_ic_star"
                        app:tint="@color/ac_star_off" />
                </LinearLayout>

                <!-- Score card -->
                <LinearLayout
                    android:id="@+id/scoreCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/ac_card"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="26dp">

                    <TextView
                        android:id="@+id/tvScoreFraction"
                        android:layout_width="124dp"
                        android:layout_height="130dp"
                        android:background="@drawable/ac_medal"
                        android:fontFamily="@font/lexend"
                        android:gravity="center"
                        android:paddingBottom="6dp"
                        android:textColor="@color/ac_ink"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="8 / 10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/quicksand_medium"
                        android:text="@string/ac_score_label"
                        android:textColor="@color/ac_ink_soft"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRemark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/lexend"
                        android:gravity="center"
                        android:textColor="@color/ac_ink"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Mahusay! Handa ka na sa susunod na hakbang." />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/quicksand_medium"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/ac_remark_sub"
                        android:textColor="@color/ac_ink_soft"
                        android:textSize="14sp" />

                    <!-- Practice lesson: the score was not saved (or, offline: saved on the phone) -->
                    <TextView
                        android:id="@+id/tvPracticeNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/ac_note_pill"
                        android:drawableStart="@drawable/ic_info_small"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/quicksand_medium"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="9dp"
                        android:text="@string/practice_not_saved"
                        android:textColor="@color/ac_ink_soft"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:drawableTint="@color/ac_ink_soft" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Practice lesson: "try again" sits beside "back"; otherwise "back" fills the row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/ac_btn_outline"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/be_vietnam_bold"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/practice_try_again"
                android:textColor="@color/ac_good_text"
                android:visibility="gone"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="13sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/ac_btn_next"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/be_vietnam_bold"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/ac_back_to_lesson"
                android:textColor="@android:color/white"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="13sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>
    </LinearLayout>

    <ph.basaya.app.ui.game.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="16dp" />
</FrameLayout>
