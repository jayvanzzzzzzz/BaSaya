<?xml version="1.0" encoding="utf-8"?>
<!-- Asking to leave the class (optional reason), and cancelling that request. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="@drawable/bg_app_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- The book buddy, looking a little worried -->
    <com.example.basaya.ui.pronunciation.PronunciationBookView
        android:id="@+id/leaveBuddy"
        android:layout_width="86dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvLeaveTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/lexend"
        android:gravity="center"
        android:textColor="#25231D"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Aalis ka ba sa klase?" />

    <TextView
        android:id="@+id/tvLeaveMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/quicksand_medium"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="#6B675D"
        android:textSize="14sp"
        tools:text="Kapag pumayag ang iyong guro, aalis ka sa Grade 8 - Aguinaldo." />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilLeaveReason"
        style="@style/Pf.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/pf_leave_dialog_reason"
        app:counterEnabled="true"
        app:counterMaxLength="200">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLeaveReason"
            style="@style/Pf.InputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="200"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLeaveConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/be_vietnam_bold"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:backgroundTint="#D64545"
        app:cornerRadius="16dp"
        tools:text="Humiling na umalis" />

    <TextView
        android:id="@+id/btnLeaveCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_bold"
        android:gravity="center"
        android:textColor="#315EAE"
        android:textSize="14sp"
        tools:text="Manatili sa klase" />
</LinearLayout>
