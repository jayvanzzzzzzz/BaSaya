<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet: edit name, gender and birthday (email can't be changed). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/lexend"
            android:text="@string/pf_edit_title"
            android:textColor="@color/pg_ink"
            android:textSize="21sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFirstName"
            style="@style/Pf.Input"
            android:hint="@string/pf_first_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFirstName"
                style="@style/Pf.InputText"
                android:autofillHints="givenName"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMiddleName"
            style="@style/Pf.Input"
            android:hint="@string/pf_middle_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMiddleName"
                style="@style/Pf.InputText"
                android:autofillHints="additionalName"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLastName"
            style="@style/Pf.Input"
            android:hint="@string/pf_last_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLastName"
                style="@style/Pf.InputText"
                android:autofillHints="familyName"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/quicksand_medium"
            android:text="@string/pf_gender"
            android:textColor="@color/pg_ink_soft"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMale"
                style="@style/Pf.GenderChip"
                android:text="@string/pf_gender_male" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFemale"
                style="@style/Pf.GenderChip"
                android:text="@string/pf_gender_female" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUnsaid"
                style="@style/Pf.GenderChip"
                android:text="@string/pf_gender_unsaid" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBirthday"
            style="@style/Pf.Input"
            android:layout_marginTop="12dp"
            android:hint="@string/pf_birthday"
            app:endIconDrawable="@drawable/pf_ic_calendar"
            app:endIconMode="custom"
            app:endIconTint="@color/pg_pagbigkas">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBirthday"
                style="@style/Pf.InputText"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:fontFamily="@font/be_vietnam_bold"
                android:text="@string/pf_cancel"
                android:textAllCaps="false"
                android:textColor="@color/pg_ink_soft"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/be_vietnam_bold"
                android:minWidth="120dp"
                android:text="@string/pf_save"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/tb_end"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
