<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notificationCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/wi_notification_read"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/wi_press"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/iconTile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/wi_index_tile">
            <ImageView
                android:id="@+id/ivKind"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_book"/>
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_bold"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/wi_action"
                android:id="@+id/tvKind"
                android:letterSpacing="0.06"
                tools:text="BAGONG ARALIN"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="3dp">
                <TextView
                    android:id="@+id/tvDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/public_sans"
                    android:textColor="@color/wi_muted"
                    android:textSize="12sp"
                    tools:text="Ngayong araw"/>
                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/public_sans"
                    android:textColor="@color/wi_muted"
                    android:textSize="12sp"
                    tools:text="3:15 PM"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/unreadDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wi_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:fontFamily="@font/be_vietnam_bold"
            android:text="@string/notif_section_new"
            android:textSize="11sp"
            android:textColor="#174C40"
            android:importantForAccessibility="no"
            android:visibility="gone"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lexend"
        android:text=""
        android:textSize="18sp"
        android:textColor="@color/wi_ink"
        android:id="@+id/tvTitle"
        android:layout_marginTop="14dp"
        android:textStyle="bold"
        tools:text="Mga Pangngalan"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/public_sans"
        android:text=""
        android:textSize="14sp"
        android:textColor="@color/wi_muted"
        android:id="@+id/tvBody"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.2"
        tools:text="May bagong aralin para sa iyo. Deadline: Nob 20, 11:59 PM"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wi_open_lesson"
            android:fontFamily="@font/be_vietnam_bold"
            android:textColor="@color/wi_action"
            android:textSize="12sp"/>
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/wi_action"
            android:importantForAccessibility="no"/>
    </LinearLayout>
</LinearLayout>
