<?xml version="1.0" encoding="utf-8"?>
<!-- Pronunciation: peach stage with the coral headphone book, word card, and teal mic. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pr_bg_scene"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.pronunciation.PronunciationActivity">

    <!-- ═══ Top bar: close · progress · lives ═══ -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/pr_btn_round_white"
        android:contentDescription="@string/pr_close"
        android:paddingBottom="3dp"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/pr_ink" />

    <ProgressBar
        android:id="@+id/progressBarWords"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/pr_progress"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintEnd_toStartOf="@id/livesIndicator"
        app:layout_constraintStart_toEndOf="@id/btnClose"
        app:layout_constraintTop_toTopOf="@id/btnClose" />

    <LinearLayout
        android:id="@+id/livesIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/pr_chip"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="7dp"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnClose">

        <ImageView
            android:id="@+id/ivHeartIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_heart_filled"
            app:tint="@color/pr_heart" />

        <TextView
            android:id="@+id/tvLivesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/be_vietnam_bold"
            android:textColor="@color/pr_heart"
            android:textSize="16sp"
            tools:text="5" />
    </LinearLayout>

    <!-- ═══ Instruction ═══ -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/pr_instruction_pill"
        android:fontFamily="@font/lexend"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="@string/pr_instruction_default"
        android:textColor="@color/pr_ink"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnClose" />

    <!-- ═══ Buddy ═══ -->
    <com.example.basaya.ui.pronunciation.PronunciationBookView
        android:id="@+id/bookView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/wordCard"
        app:layout_constraintDimensionRatio="240:282"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="240dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvInstruction" />

    <!-- ═══ Word card ═══ -->
    <LinearLayout
        android:id="@+id/wordCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/pr_word_card"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="17dp"
        app:layout_constraintBottom_toTopOf="@id/resultStickyNote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvTargetWord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/lexend"
            android:gravity="center"
            android:textColor="@color/pr_ink"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="Bahay" />

        <ImageButton
            android:id="@+id/btnSpeaker"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/pr_btn_speaker"
            android:contentDescription="@string/pr_play_word"
            android:padding="15dp"
            android:paddingBottom="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_speaker_on"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- ═══ Result bubble (space is reserved so nothing jumps) ═══ -->
    <LinearLayout
        android:id="@+id/resultStickyNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="4dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/pr_result_success"
        android:gravity="center"
        android:minHeight="64dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/micButtonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvResultBand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend"
            android:gravity="center"
            android:textColor="@color/pr_success"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Ang galing mo!" />

        <TextView
            android:id="@+id/tvRecognizedWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/quicksand_medium"
            android:gravity="center"
            android:textColor="@color/pr_ink_soft"
            android:textSize="14sp"
            tools:text="Narinig ko: bahay" />
    </LinearLayout>

    <!-- ═══ Microphone ═══ -->
    <FrameLayout
        android:id="@+id/micButtonContainer"
        android:layout_width="170dp"
        android:layout_height="150dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/tvMicHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/pulseRing1"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/pr_pulse_ring"
            android:visibility="invisible" />

        <View
            android:id="@+id/pulseRing2"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/pr_pulse_ring"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/pr_btn_mic"
            android:contentDescription="@string/pr_record"
            android:elevation="4dp"
            android:padding="26dp"
            android:paddingBottom="32dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            app:tint="@android:color/white" />

        <ProgressBar
            android:id="@+id/micProcessingSpinner"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:elevation="5dp"
            android:indeterminateTint="@color/pr_coral"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvMicHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/quicksand_medium"
        android:gravity="center"
        android:text="@string/pr_mic_hint_idle"
        android:textColor="@color/pr_ink"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Confetti draws above everything and never takes touches -->
    <com.example.basaya.ui.game.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
