<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/desk_background"
    android:id="@+id/main"
    tools:context=".ui.pronunciation.PronunciationActivity">

    <!-- Status bar background, matching your existing edge-to-edge pattern -->
    <View
        android:id="@+id/statusBarBg"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ============ TOP TOOLBAR ROW ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topToolbarRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/statusBarBg">

        <!-- Close button (circular X) -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button_white"
            android:src="@drawable/ic_close"
            android:contentDescription="Close"
            android:padding="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Progress bar (highlighter style) -->
        <ProgressBar
            android:id="@+id/progressBarWords"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:progressDrawable="@drawable/progress_highlighter_green"
            android:max="100"
            android:progress="0"
            app:layout_constraintStart_toEndOf="@id/btnClose"
            app:layout_constraintEnd_toStartOf="@id/livesIndicator"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <!-- Lives indicator: heart icon + count -->
        <LinearLayout
            android:id="@+id/livesIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivHeartIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_heart_filled"
                app:tint="@color/heart_red"
                android:contentDescription="Lives" />

            <TextView
                android:id="@+id/tvLivesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/quicksand_medium"
                android:textColor="@color/heart_red" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============ WASHI TAPE LABEL ============ -->
    <TextView
        android:id="@+id/labelWashiTape"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bigkasin ang salitang ito."
        android:fontFamily="@font/lexend"
        android:textSize="16sp"
        android:textColor="@color/text_on_tape"
        android:background="@drawable/bg_washi_tape"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:rotation="-2"
        app:layout_constraintTop_toBottomOf="@id/topToolbarRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- ============ STORYBOOK CARD ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/storybookCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="28dp"
        android:rotation="1.5"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/card_paper_white"
        app:layout_constraintTop_toBottomOf="@id/labelWashiTape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Book character (static two-frame placeholder for now) -->
            <ImageView
                android:id="@+id/ivBookCharacter"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/book_1"
                android:contentDescription="Book character"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <!-- TODO: swap ic_book_mouth_closed / ic_book_mouth_open via frame animation later -->

            <!-- Target word -->
            <TextView
                android:id="@+id/tvTargetWord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="..."
                android:fontFamily="@font/lexend"
                android:textStyle="bold"
                android:textSize="28sp"
                android:textColor="@color/primary_purple"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivBookCharacter" />

            <!-- Speaker button -->
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_button_blue"
                android:src="@drawable/ic_speaker_on"
                android:contentDescription="Play pronunciation"
                android:padding="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTargetWord"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ============ RESULT STICKY NOTE (hidden by default) ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/resultStickyNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_sticky_note_green"
        android:padding="16dp"
        android:visibility="gone"
        android:rotation="-1.5"
        app:layout_constraintTop_toBottomOf="@id/storybookCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/tvResultBand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ang galing!"
            android:fontFamily="@font/quicksand_medium"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/text_on_sticky"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvRecognizedWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Narinig: kumusta"
            android:fontFamily="@font/quicksand_medium"
            android:textSize="14sp"
            android:textColor="@color/text_on_sticky"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvResultBand"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============ MIC BUTTON (ink-stamp style) ============ -->
    <FrameLayout
        android:id="@+id/micButtonContainer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="40dp">

        <!-- Two ripple rings, staggered so one is always visible while listening -->
        <View
            android:id="@+id/pulseRing1"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse_ring"
            android:visibility="invisible" />

        <View
            android:id="@+id/pulseRing2"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse_ring"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ink_stamp_mic"
            android:src="@drawable/ic_mic"
            android:contentDescription="Record pronunciation"
            android:padding="20dp"
            android:clickable="false"/>

        <ProgressBar
            android:id="@+id/micProcessingSpinner"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>