<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="@drawable/bg_offline_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_offline_icon">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Offline"
            android:src="@drawable/ic_download_modern" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvOfflineTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/lexend"
        android:gravity="center"
        android:text="Hindi available offline"
        android:textColor="#25231D"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOfflineMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/quicksand_medium"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="#686257"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOfflineOkay"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/quicksand_medium"
        android:text="Naiintindihan ko"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#315EAE"
        app:cornerRadius="16dp" />

</LinearLayout>