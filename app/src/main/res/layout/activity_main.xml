<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <View
        android:id="@+id/statusBarBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/toolbar_bar_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════
      TOP APP BAR — modern floating card style
 ════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="12dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBg">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar_bar_color"
            android:elevation="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            app:contentInsetStart="0dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_medium"
                    android:letterSpacing="0.01"
                    android:text="@string/app_title"
                    android:textColor="@color/main_blue"
                    android:textSize="26sp"
                    android:layout_weight="1"
                    android:textStyle="bold"/>

                <!-- Right Actions -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Notification Button with Badge -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="2dp">

                        <ImageButton
                            android:id="@+id/btnNotification"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_toolbar_icon_btn"
                            android:contentDescription="@string/notifications"
                            android:padding="11dp"
                            android:src="@drawable/ic_notifications"
                            app:tint="@color/muted" />

                        <!-- Notification Badge -->
                        <TextView
                            android:id="@+id/tvNotifBadge"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_badge"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="visible" />

                    </FrameLayout>
            </LinearLayout>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"

                    android:text="@string/name"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/muted"/>

                <!-- 3-Dot More Options -->
                <ImageButton
                    android:id="@+id/btnMoreOptions"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_toolbar_icon_btn"
                    android:contentDescription="@string/more_options"
                    android:padding="11dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/muted" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout" />

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavCard"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/nav_card_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Sliding pill indicator, animated in Kotlin -->
            <View
                android:id="@+id/navIndicator"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nav_indicator" />

            <LinearLayout
                android:id="@+id/navItemsRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:id="@+id/navHome"
                    style="@style/NavItemStyle">
                    <ImageView
                        android:id="@+id/iconHome"
                        style="@style/NavIconStyle"
                        android:src="@drawable/ic_home" />
                    <TextView
                        android:id="@+id/labelHome"
                        style="@style/NavLabelStyle"
                        android:text="Mga Aralin" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/navProgress"
                    style="@style/NavItemStyle">
                    <ImageView
                        android:id="@+id/iconPractice"
                        style="@style/NavIconStyle"
                        android:src="@drawable/ic_progress" />
                    <TextView
                        android:id="@+id/labelPractice"
                        style="@style/NavLabelStyle"
                        android:text="Progreso" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navProfile"
                    style="@style/NavItemStyle">
                    <ImageView
                        android:id="@+id/iconProfile"
                        style="@style/NavIconStyle"
                        android:src="@drawable/ic_account_info" />
                    <TextView
                        android:id="@+id/labelProfile"
                        style="@style/NavLabelStyle"
                        android:text="Account" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>