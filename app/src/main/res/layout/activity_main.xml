<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <View
        android:id="@+id/statusBarBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/toolbar_bar_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════
      TOP APP BAR — modern floating card style
 ════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:elevation="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBg">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar_bar_color"
            android:elevation="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:contentInsetStart="0dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Avatar + chevron badge -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <TextView
                        android:id="@+id/tvAvatarInitial"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/bg_avatar_placeholder"
                        android:contentDescription="@string/profile_picture"
                        android:fontFamily="@font/quicksand_medium"
                        android:gravity="center"
                        android:text="B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivProfileChevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-8dp"
                        android:layout_marginBottom="3dp"
                        android:background="@drawable/bg_chevron_badge"
                        android:padding="2dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/main_blue" />

                </FrameLayout>

                <!-- First name, beside avatar -->
                <TextView
                    android:id="@+id/tvFirstName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/public_sans"
                    android:text="@string/name"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Right Actions -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Notification Button with Badge -->
                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="20dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <!-- Soft circular backdrop — larger than the icon for a visible glow -->
                        <View
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_gravity="center"
                            android:alpha="0.3"
                            android:background="@drawable/notif_circle_placeholder" />

                        <ImageButton
                            android:id="@+id/btnNotification"
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/notifications"
                            android:padding="11dp"
                            android:src="@drawable/ic_notifications"
                            app:tint="@color/muted" />

                        <TextView
                            android:id="@+id/tvNotifBadge"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_badge"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="visible" />

                    </FrameLayout>

                    <!-- 3-Dot More Options
                    <ImageButton
                        android:id="@+id/btnMoreOptions"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_toolbar_icon_btn"
                        android:contentDescription="@string/more_options"
                        android:padding="11dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="@color/muted" />
                -->
                </LinearLayout>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout" />

    <!-- ═══════════════════════════════════════════
  FLOATING BOTTOM NAV — icon / underline / label
════════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavCard"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/nav_card_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/navItemsRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- HOME -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/iconHome"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="11dp"
                        android:src="@drawable/ic_home"
                        app:tint="@color/nav_item_color"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/labelHome"
                        style="@style/NavLabelStyle"
                        android:layout_marginTop="8dp"
                        android:text="Mga Aralin"
                        app:layout_constraintTop_toBottomOf="@id/iconHome"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- PROGRESS -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/navProgress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/iconPractice"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="11dp"
                        android:src="@drawable/ic_progress"
                        app:tint="@color/nav_item_color"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/labelPractice"
                        style="@style/NavLabelStyle"
                        android:layout_marginTop="8dp"
                        android:text="Progreso"
                        app:layout_constraintTop_toBottomOf="@id/iconPractice"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- PROFILE -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/navProfile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/iconProfile"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="11dp"
                        android:src="@drawable/ic_account_info"
                        app:tint="@color/nav_item_color"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/labelProfile"
                        style="@style/NavLabelStyle"
                        android:layout_marginTop="8dp"
                        android:text="Account"
                        app:layout_constraintTop_toBottomOf="@id/iconProfile"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <!-- Single shared underline — position/width animated in Kotlin -->
            <View
                android:id="@+id/navUnderline"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_gravity="top|start"
                android:background="@color/nav_item_color_active" />

        </FrameLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>