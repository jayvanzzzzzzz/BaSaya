<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/actionDownload"
        style="@style/LessonOptions.Action"
        android:drawableStart="@drawable/ic_download"
        android:drawableTint="@color/lesson_card_primary"
        android:text="@string/lesson_card_download_cd" />

    <View
        android:id="@+id/optionsDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/lesson_card_divider" />

    <TextView
        android:id="@+id/actionRemoveDownload"
        style="@style/LessonOptions.Action"
        android:drawableStart="@drawable/ic_lesson_remove"
        android:text="@string/lesson_card_remove_download"
        android:textColor="@color/lesson_card_body" />
</LinearLayout>
