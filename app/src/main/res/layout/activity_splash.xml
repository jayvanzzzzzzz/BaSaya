<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    tools:context=".ui.SplashActivity">

    <!-- Soft waves along the bottom; sways gently (animated from SplashActivity). -->
    <ImageView
        android:id="@+id/splashWave"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:scaleX="1.2"
        android:src="@drawable/splash_wave"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Night Sky only (see splashNightScenery): a glowing moon, floated from SplashActivity. -->
    <ImageView
        android:id="@+id/splashMoon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_moon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.46"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.07"
        tools:ignore="ContentDescription" />

    <!-- Floating bubbles and twinkling stars (tagged so SplashActivity can animate them). -->
    <View
        android:id="@+id/splashBubbleMint"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/splash_circle"
        android:backgroundTint="@color/splash_bubble_mint"
        android:tag="bubble"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.88"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.07" />

    <View
        android:id="@+id/splashBubbleViolet"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/splash_circle"
        android:backgroundTint="@color/splash_bubble_violet"
        android:tag="bubble"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.06"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.32" />

    <View
        android:id="@+id/splashBubblePeach"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/splash_circle"
        android:backgroundTint="@color/splash_bubble_peach"
        android:tag="bubble"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.76" />

    <View
        android:id="@+id/splashBubbleSky"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/splash_circle"
        android:backgroundTint="@color/splash_bubble_sky"
        android:tag="bubble"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.7" />

    <ImageView
        android:id="@+id/splashStarGold"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_star"
        android:tag="star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.13"
        app:tint="@color/splash_star_gold"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/splashStarPink"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_star"
        android:tag="star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.22"
        app:tint="@color/splash_star_pink"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/splashStarSky"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_star"
        android:tag="star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.92"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.52"
        app:tint="@color/splash_star_sky"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/splashStarGoldSmall"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_star"
        android:tag="star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.62"
        app:tint="@color/splash_star_gold"
        tools:ignore="ContentDescription" />

    <!-- Night Sky only: tiny extra twinkles. Kept after the stars above so the light theme's
         pop-in timing stays the same. -->
    <ImageView
        android:id="@+id/splashSparkleA"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_sparkle"
        android:tag="star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.34"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.24"
        app:tint="@color/ns_moon"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/splashSparkleB"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_sparkle"
        android:tag="star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.36"
        app:tint="@color/ns_ink"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/splashSparkleC"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_sparkle"
        android:tag="star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.04"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55"
        app:tint="@color/ns_moon"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/splashSparkleD"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_sparkle"
        android:tag="star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.77"
        app:tint="@color/ns_ink"
        tools:ignore="ContentDescription" />

    <!-- Hidden in the light theme; SplashActivity shows it in Night Sky. -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/splashNightScenery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="splashMoon,splashSparkleA,splashSparkleB,splashSparkleC,splashSparkleD" />

    <!-- Logo, "BaSaya" letter blocks and the loading dots. -->
    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="200dp">

            <View
                android:id="@+id/splashGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/splash_glow" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/splashLogoCard"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/splash_logo_card"
                app:cardCornerRadius="40dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/logo"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- One block per letter, added from SplashActivity. -->
        <LinearLayout
            android:id="@+id/splashLetters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:contentDescription="@string/app_title"
            android:importantForAccessibility="yes"
            android:orientation="horizontal"
            android:paddingTop="16dp" />

        <LinearLayout
            android:id="@+id/splashDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:importantForAccessibility="no"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/splash_circle"
                android:backgroundTint="@color/splash_block_gold" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/splash_circle"
                android:backgroundTint="@color/splash_block_coral" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/splash_circle"
                android:backgroundTint="@color/splash_block_sky" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
