<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:orientation="vertical">

    <!-- ─── HEADER (top inset added in DashboardActivity) ─── -->
    <LinearLayout
        android:id="@+id/dashboardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dash_header_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/dash_screen_padding_h"
        android:paddingTop="@dimen/dash_header_padding_top"
        android:paddingEnd="@dimen/dash_screen_padding_h"
        android:paddingBottom="@dimen/dash_header_padding_bottom">

        <!-- "ARALIN" + decorative dot -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Dash.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lesson_dash_eyebrow" />

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot_accent"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLessonTitle"
            style="@style/TextAppearance.Dash.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Lesson Title" />

        <View
            android:layout_width="@dimen/dash_accent_line_w"
            android:layout_height="@dimen/dash_accent_line_h"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_header_accent_line"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvLessonDesc"
            style="@style/TextAppearance.Dash.Desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            tools:text="Lesson Description" />

    </LinearLayout>

    <!-- Header divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dash_stroke"
        android:background="@color/dash_divider"
        android:importantForAccessibility="no" />

    <!-- ─── SCROLLABLE CONTENT (bottom inset added in DashboardActivity) ─── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/dashboardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dash_screen_padding_h"
            android:paddingTop="@dimen/dash_content_padding_top"
            android:paddingEnd="@dimen/dash_screen_padding_h"
            android:paddingBottom="@dimen/dash_content_padding_bottom">

            <TextView
                style="@style/TextAppearance.Dash.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/lesson_dash_section_start"
                tools:targetApi="p" />

            <!-- ════════════ LECTURE (hero) ════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lectureCard"
                style="@style/Widget.Dash.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dash_section_heading_gap"
                app:cardBackgroundColor="@color/dash_lecture_tint"
                app:strokeColor="@color/dash_lecture_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dash_card_padding_hero">

                    <ImageView
                        android:layout_width="@dimen/dash_icon_container_hero"
                        android:layout_height="@dimen/dash_icon_container_hero"
                        android:background="@drawable/bg_dashboard_icon"
                        android:backgroundTint="@color/dash_surface"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/dash_icon_padding_hero"
                        android:src="@drawable/ic_book"
                        app:tint="@color/dash_lecture" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Dash.CardTitleHero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lesson_dash_lecture_title" />

                        <TextView
                            style="@style/TextAppearance.Dash.CardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/lesson_dash_lecture_sub" />

                        <!-- Meta row: wraps the pill onto a new line at large font scales -->
                        <com.google.android.flexbox.FlexboxLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:alignItems="center"
                            app:flexWrap="wrap">

                            <TextView
                                android:id="@+id/tvLectureCount"
                                style="@style/TextAppearance.Dash.Badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="8dp"
                                android:backgroundTint="@color/dash_surface"
                                android:text="@string/lesson_dash_count_placeholder"
                                android:textColor="@color/dash_lecture" />

                            <LinearLayout
                                android:id="@+id/lectureCompletedBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_dashboard_done"
                                android:contentDescription="@string/lesson_dash_done"
                                android:gravity="center_vertical"
                                android:minHeight="@dimen/dash_badge_min_height"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <ImageView
                                    android:layout_width="@dimen/dash_pill_icon"
                                    android:layout_height="@dimen/dash_pill_icon"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_check"
                                    app:tint="@color/dash_done_fg" />

                                <TextView
                                    style="@style/TextAppearance.Dash.Pill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/dash_pill_gap"
                                    android:importantForAccessibility="no"
                                    android:text="@string/lesson_dash_done" />
                            </LinearLayout>
                        </com.google.android.flexbox.FlexboxLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════ GAME & ACTIVITY (side by side) ════════════ -->
            <TextView
                style="@style/TextAppearance.Dash.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dash_section_gap"
                android:accessibilityHeading="true"
                android:text="@string/lesson_dash_section_practice"
                tools:targetApi="p" />

            <!-- Cards use match_parent height so LinearLayout forces both to the
                 taller card's height; the weighted Space pins badges to the bottom. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dash_section_heading_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- GAME -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/gameCard"
                    style="@style/Widget.Dash.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/dash_card_padding">

                        <ImageView
                            android:layout_width="@dimen/dash_icon_container"
                            android:layout_height="@dimen/dash_icon_container"
                            android:background="@drawable/bg_dashboard_icon"
                            android:backgroundTint="@color/dash_laro_tint"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/dash_icon_padding"
                            android:src="@drawable/ic_puzzle"
                            app:tint="@color/dash_laro" />

                        <TextView
                            style="@style/TextAppearance.Dash.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/lesson_dash_game_title" />

                        <TextView
                            style="@style/TextAppearance.Dash.CardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/lesson_dash_game_sub" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:minHeight="12dp" />

                        <TextView
                            android:id="@+id/tvGameCount"
                            style="@style/TextAppearance.Dash.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/dash_laro_tint"
                            android:text="@string/lesson_dash_count_placeholder"
                            android:textColor="@color/dash_laro" />

                        <LinearLayout
                            android:id="@+id/gameCompletedBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_dashboard_done"
                            android:contentDescription="@string/lesson_dash_done"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/dash_badge_min_height"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ImageView
                                android:layout_width="@dimen/dash_pill_icon"
                                android:layout_height="@dimen/dash_pill_icon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_check"
                                app:tint="@color/dash_done_fg" />

                            <TextView
                                style="@style/TextAppearance.Dash.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dash_pill_gap"
                                android:importantForAccessibility="no"
                                android:text="@string/lesson_dash_done" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ACTIVITY -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/activityCard"
                    style="@style/Widget.Dash.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/dash_card_padding">

                        <ImageView
                            android:layout_width="@dimen/dash_icon_container"
                            android:layout_height="@dimen/dash_icon_container"
                            android:background="@drawable/bg_dashboard_icon"
                            android:backgroundTint="@color/dash_gawain_tint"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/dash_icon_padding"
                            android:src="@drawable/ic_pencil"
                            app:tint="@color/dash_gawain" />

                        <TextView
                            style="@style/TextAppearance.Dash.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/lesson_dash_activity_title" />

                        <TextView
                            style="@style/TextAppearance.Dash.CardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/lesson_dash_activity_sub" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:minHeight="12dp" />

                        <TextView
                            android:id="@+id/tvActivityCount"
                            style="@style/TextAppearance.Dash.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/dash_gawain_tint"
                            android:text="@string/lesson_dash_count_placeholder"
                            android:textColor="@color/dash_gawain" />

                        <LinearLayout
                            android:id="@+id/activityCompletedBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_dashboard_done"
                            android:contentDescription="@string/lesson_dash_done"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/dash_badge_min_height"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ImageView
                                android:layout_width="@dimen/dash_pill_icon"
                                android:layout_height="@dimen/dash_pill_icon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_check"
                                app:tint="@color/dash_done_fg" />

                            <TextView
                                style="@style/TextAppearance.Dash.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dash_pill_gap"
                                android:importantForAccessibility="no"
                                android:text="@string/lesson_dash_done" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ════════════ PRONUNCIATION ════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pronunciationCard"
                style="@style/Widget.Dash.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dash_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dash_card_padding">

                    <ImageView
                        android:layout_width="@dimen/dash_icon_container"
                        android:layout_height="@dimen/dash_icon_container"
                        android:background="@drawable/bg_dashboard_icon"
                        android:backgroundTint="@color/dash_bigkas_tint"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/dash_icon_padding"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/dash_bigkas" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Dash.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lesson_dash_pron_title" />

                        <TextView
                            style="@style/TextAppearance.Dash.CardSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/lesson_dash_pron_sub" />

                        <com.google.android.flexbox.FlexboxLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:alignItems="center"
                            app:flexWrap="wrap">

                            <TextView
                                android:id="@+id/tvPronunciationCount"
                                style="@style/TextAppearance.Dash.Badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="8dp"
                                android:backgroundTint="@color/dash_bigkas_tint"
                                android:text="@string/lesson_dash_count_placeholder"
                                android:textColor="@color/dash_bigkas" />

                            <LinearLayout
                                android:id="@+id/pronunciationCompletedBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_dashboard_done"
                                android:contentDescription="@string/lesson_dash_done"
                                android:gravity="center_vertical"
                                android:minHeight="@dimen/dash_badge_min_height"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <ImageView
                                    android:layout_width="@dimen/dash_pill_icon"
                                    android:layout_height="@dimen/dash_pill_icon"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_check"
                                    app:tint="@color/dash_done_fg" />

                                <TextView
                                    style="@style/TextAppearance.Dash.Pill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/dash_pill_gap"
                                    android:importantForAccessibility="no"
                                    android:text="@string/lesson_dash_done" />
                            </LinearLayout>
                        </com.google.android.flexbox.FlexboxLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════ QUIZ (with lock overlay) ════════════ -->
            <!-- Card is match_parent so it always grows to the overlay's height and
                 vice versa; both have 0dp elevation, so the overlay (declared later)
                 draws on top. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dash_card_gap">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quizCard"
                    style="@style/Widget.Dash.Card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="88dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/dash_card_padding">

                        <ImageView
                            android:layout_width="@dimen/dash_icon_container"
                            android:layout_height="@dimen/dash_icon_container"
                            android:background="@drawable/bg_dashboard_icon"
                            android:backgroundTint="@color/dash_quiz_tint"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/dash_icon_padding"
                            android:src="@drawable/ic_clipboard_check"
                            app:tint="@color/dash_quiz" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Dash.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lesson_dash_quiz_title" />

                            <TextView
                                style="@style/TextAppearance.Dash.CardSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/lesson_dash_quiz_sub" />

                            <com.google.android.flexbox.FlexboxLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                app:alignItems="center"
                                app:flexWrap="wrap">

                                <TextView
                                    android:id="@+id/tvQuizCount"
                                    style="@style/TextAppearance.Dash.Badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:layout_marginEnd="8dp"
                                    android:backgroundTint="@color/dash_quiz_tint"
                                    android:text="@string/lesson_dash_count_placeholder"
                                    android:textColor="@color/dash_quiz" />

                                <LinearLayout
                                    android:id="@+id/quizCompletedBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/bg_dashboard_done"
                                    android:contentDescription="@string/lesson_dash_done"
                                    android:gravity="center_vertical"
                                    android:minHeight="@dimen/dash_badge_min_height"
                                    android:orientation="horizontal"
                                    android:paddingStart="8dp"
                                    android:paddingTop="4dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="4dp"
                                    android:visibility="gone"
                                    tools:visibility="visible">

                                    <ImageView
                                        android:layout_width="@dimen/dash_pill_icon"
                                        android:layout_height="@dimen/dash_pill_icon"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_check"
                                        app:tint="@color/dash_done_fg" />

                                    <TextView
                                        style="@style/TextAppearance.Dash.Pill"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/dash_pill_gap"
                                        android:importantForAccessibility="no"
                                        android:text="@string/lesson_dash_done" />
                                </LinearLayout>
                            </com.google.android.flexbox.FlexboxLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Lock overlay: shown by default, hidden by DashboardActivity once unlocked -->
                <LinearLayout
                    android:id="@+id/quizLockOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dashboard_lock"
                    android:clickable="true"
                    android:contentDescription="@string/lesson_dash_locked_cd"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_dashboard_icon"
                        android:backgroundTint="@color/dash_surface"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_lock_small"
                        app:tint="@color/dash_lock_icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/quicksand_medium"
                        android:importantForAccessibility="no"
                        android:text="@string/lesson_dash_locked_msg"
                        android:textColor="@color/dash_lock_fg"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
