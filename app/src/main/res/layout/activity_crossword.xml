<?xml version="1.0" encoding="utf-8"?>
<!-- Crossword game: drawn sunny-sky scene, candy board, and letter wheel. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cw_bg_scene"
    tools:context=".ui.game.CrosswordActivity">

    <!-- ═══ Decorative sky (animated in code) ═══ -->
    <ImageView
        android:id="@+id/cwSun"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-28dp"
        android:layout_marginEnd="-28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/cw_sun" />

    <ImageView
        android:id="@+id/cwCloudTop"
        android:layout_width="110dp"
        android:layout_height="55dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="64dp"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/cw_cloud" />

    <ImageView
        android:id="@+id/cwCloudMid"
        android:layout_width="84dp"
        android:layout_height="42dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:alpha="0.75"
        android:importantForAccessibility="no"
        android:src="@drawable/cw_cloud" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ═══ Header ═══ -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/cw_btn_round"
            android:contentDescription="@string/cw_back"
            android:paddingBottom="3dp"
            android:src="@drawable/cw_ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/cw_ink" />

        <TextView
            android:id="@+id/tvLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/cw_chip"
            android:fontFamily="@font/lexend"
            android:minHeight="44dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="9dp"
            android:textColor="@color/cw_ink"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/progressChip"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            tools:text="Antas 1" />

        <LinearLayout
            android:id="@+id/progressChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/cw_chip"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="7dp"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack">

            <ImageView
                android:id="@+id/ivProgressStar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cw_ic_star"
                app:tint="@color/cw_star" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/be_vietnam_bold"
                android:textColor="@color/cw_ink"
                android:textSize="16sp"
                tools:text="0/5" />
        </LinearLayout>

        <!-- ═══ Crossword board ═══ -->
        <ScrollView
            android:id="@+id/boardVerticalScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/cw_board_panel"
            android:elevation="4dp"
            android:fillViewport="true"
            android:padding="10dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/tempTv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack">

            <HorizontalScrollView
                android:id="@+id/boardHorizontalScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none">

                <FrameLayout
                    android:id="@+id/wordContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </HorizontalScrollView>
        </ScrollView>

        <!-- ═══ Word being spelled ═══ -->
        <TextView
            android:id="@+id/tempTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/cw_preview_pill"
            android:elevation="4dp"
            android:fontFamily="@font/be_vietnam_bold"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:minWidth="96dp"
            android:minHeight="52dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:textAllCaps="true"
            android:textColor="@color/cw_ink"
            android:textSize="26sp"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@id/letterContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="BAHAY"
            tools:visibility="visible" />

        <!-- ═══ Letter wheel ═══ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/letterContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/cw_wheel"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="290dp"
            app:layout_constraintWidth_percent="0.74">

            <ImageButton
                android:id="@+id/btnShuffle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/cw_btn_shuffle"
                android:contentDescription="@string/cw_shuffle"
                android:paddingBottom="3dp"
                android:src="@drawable/cw_ic_shuffle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/cw_shuffle_icon" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Confetti draws above everything and never takes touches -->
    <ph.basaya.app.ui.game.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="16dp" />
</FrameLayout>
