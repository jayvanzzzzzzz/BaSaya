<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lecture_screen"
    android:orientation="vertical"
    tools:context=".ui.LectureActivity">

    <!-- The activity creates one rounded "stepping stone" per page inside this container. -->
    <LinearLayout
        android:id="@+id/llProgressBars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/ibClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_lecture_round_button"
            android:contentDescription="@string/lecture_close_cd"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lecture_close"
            app:tint="@color/lecture_ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/public_sans"
                android:letterSpacing="0.12"
                android:textColor="@color/lecture_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="PAHINA 1 NG 3" />

            <TextView
                android:id="@+id/tvLectureTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="@font/lexend"
                android:maxLines="1"
                android:text="@string/lecture_default_title"
                android:textColor="@color/lecture_ink"
                android:textSize="21sp"
                android:textStyle="bold"
                tools:targetApi="p"
                tools:text="Pang-uri" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ibAutoPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_lecture_round_button"
            android:contentDescription="@string/lecture_auto_play_cd"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lecture_play"
            app:tint="@color/lecture_primary" />

        <ImageButton
            android:id="@+id/ibSpeaker"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_lecture_round_button"
            android:contentDescription="@string/lecture_speaker_cd"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_speaker_on"
            app:tint="@color/lecture_primary" />
    </LinearLayout>

    <!-- Storybook page -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/lecture_paper"
        app:cardCornerRadius="28dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/lecture_paper_stroke"
        app:strokeWidth="1.5dp">

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:focusable="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/allSentenceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="false"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="22dp"
                android:paddingEnd="16dp"
                android:paddingBottom="22dp"
                tools:ignore="UselessParent" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Narrator row: talking book + speech bubble / next button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <ph.basaya.app.ui.lecture.TalkingBookView
            android:id="@+id/talkingBook"
            android:layout_width="104dp"
            android:layout_height="114dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/lecture_book_cd"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/talkingBook"
            app:layout_constraintTop_toTopOf="@id/talkingBook">

            <TextView
                android:id="@+id/tvContinueHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lecture_bubble"
                android:fontFamily="@font/lexend"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="@string/lecture_tap_hint"
                android:textColor="@color/lecture_ink"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lexend"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.04"
                android:minHeight="58dp"
                android:text="@string/next"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/lecture_primary"
                app:cornerRadius="20dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_right_arrow"
                app:iconGravity="textEnd"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="@android:color/white"
                app:rippleColor="#33FFFFFF"
                app:strokeWidth="0dp" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
