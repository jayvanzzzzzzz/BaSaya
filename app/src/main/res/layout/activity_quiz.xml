<?xml version="1.0" encoding="utf-8"?>
<!-- Quiz (Pagsusulit): space adventure with a rocket progress track and game-show answers. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/qz_bg_scene"
    tools:context=".ui.quiz.QuizActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- ═══ Header ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/qz_glass_circle"
                android:contentDescription="@string/qz_close"
                android:src="@drawable/ic_close"
                app:tint="@color/qz_on_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_bold"
                    android:letterSpacing="0.12"
                    android:text="@string/qz_label"
                    android:textAllCaps="true"
                    android:textColor="@color/qz_label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvQuizTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/qz_on_bg"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Pangngalan" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Rocket progress ═══ -->
        <FrameLayout
            android:id="@+id/rocketTrack"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:clipChildren="false"
            android:importantForAccessibility="noHideDescendants">

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/qz_glass_pill" />

            <View
                android:id="@+id/trackFill"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/qz_track_fill" />

            <ImageView
                android:id="@+id/ivRocket"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:src="@drawable/qz_rocket" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvQuestionProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/qz_glass_pill"
                android:fontFamily="@font/be_vietnam_bold"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/qz_on_bg"
                android:textSize="14sp"
                tools:text="Tanong 1 ng 5" />

            <TextView
                android:id="@+id/tvPickHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_medium"
                android:gravity="end"
                android:text="@string/qz_pick"
                android:textColor="@color/qz_on_bg_soft"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ═══ Question & answers ═══ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/qz_card"
                    android:elevation="2dp"
                    android:fontFamily="@font/lexend"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="120dp"
                    android:paddingStart="22dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="28dp"
                    android:textColor="@color/qz_ink"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    tools:text="Alin sa mga sumusunod ang pangngalan?" />

                <LinearLayout
                    android:id="@+id/choicesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ═══ Next ═══ -->
        <TextView
            android:id="@+id/btnNextQuestion"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/qz_btn_next"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_bold"
            android:gravity="center"
            android:paddingBottom="5dp"
            android:text="@string/qz_next"
            android:textColor="@color/qz_btn_text"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
