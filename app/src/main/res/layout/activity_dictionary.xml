<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wi_bg"
    tools:context=".ui.dictionary.DictionaryActivity">
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:focusableInTouchMode="true">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/wi_bg"
                android:stateListAnimator="@null"
                app:elevation="0dp"
                app:liftOnScroll="false">
                <LinearLayout
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/wi_hero"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp"
                    app:layout_scrollFlags="scroll|enterAlways|exitUntilCollapsed|snap">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageButton
                            android:id="@+id/btnBack"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/wi_hero_button"
                            android:stateListAnimator="@animator/wi_press"
                            android:contentDescription="@string/close"
                            android:padding="13dp"
                            android:src="@drawable/cw_ic_back"
                            app:tint="@android:color/white"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lexend"
                            android:text="@string/dict_title"
                            android:textSize="20sp"
                            android:textColor="@android:color/white"
                            android:id="@+id/tvScreenTitle"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_bold"
                                android:text="@string/wi_dict_kicker"
                                android:textSize="11sp"
                                android:textColor="@color/wi_mint"
                                android:letterSpacing="0.09"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/lexend"
                                android:text="@string/wi_dict_hero"
                                android:textSize="27sp"
                                android:textColor="@android:color/white"
                                android:id="@+id/tvHeroTitle"
                                android:layout_marginTop="8dp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <FrameLayout
                            android:id="@+id/heroArtwork"
                            android:layout_width="112dp"
                            android:layout_height="132dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="noHideDescendants">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/wi_word_art"
                                android:importantForAccessibility="no"/>
                            <ph.basaya.app.ui.pronunciation.PronunciationBookView
                                android:id="@+id/buddy"
                                android:layout_width="54dp"
                                android:layout_height="64dp"
                                android:layout_gravity="bottom|end"/>
                        </FrameLayout>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/public_sans"
                        android:text="@string/wi_dict_intro"
                        android:textSize="14sp"
                        android:textColor="@color/wi_hero_soft"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="58dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/wi_surface"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_search"
                            app:tint="@color/wi_action"/>
                        <EditText
                            android:id="@+id/etSearch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/be_vietnam_medium"
                            android:hint="@string/dict_search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text|textNoSuggestions"
                            android:maxLength="60"
                            android:maxLines="1"
                            android:autofillHints=""
                            android:textColor="@color/wi_ink"
                            android:textColorHint="@color/wi_muted"
                            android:textSize="15sp"/>
                        <ImageButton
                            android:id="@+id/btnClearSearch"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/wi_clear_search"
                            android:src="@drawable/ic_close"
                            android:padding="15dp"
                            app:tint="@color/wi_muted"
                            android:visibility="gone"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_bold"
                        android:text="@string/wi_alphabet"
                        android:textSize="11sp"
                        android:textColor="@color/wi_muted"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.1"/>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:scrollbars="none"
                        android:contentDescription="@string/dict_letters_cd">
                        <LinearLayout
                            android:id="@+id/lettersRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"/>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerWords"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp"
                    tools:listitem="@layout/item_dictionary_word"/>
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/detailScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/detailCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/wi_word_paper"
                        android:orientation="vertical"
                        android:padding="20dp"/>
                </androidx.core.widget.NestedScrollView>
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/emptyState"
                    android:visibility="gone"
                    android:fillViewport="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:paddingTop="24dp"
                        android:paddingBottom="24dp">
                        <ImageView
                            android:layout_width="104dp"
                            android:layout_height="112dp"
                            android:src="@drawable/wi_word_art"
                            android:importantForAccessibility="no"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lexend"
                            android:text="@string/dict_empty_title"
                            android:textSize="20sp"
                            android:textColor="@color/wi_ink"
                            android:id="@+id/tvEmptyTitle"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/public_sans"
                            android:text=""
                            android:textSize="14sp"
                            android:textColor="@color/wi_muted"
                            android:id="@+id/tvEmptyBody"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"/>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="32dp"
                    android:indeterminateTint="@color/wi_action"
                    android:visibility="gone"/>
            </FrameLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/public_sans"
            android:text="@string/dict_credit"
            android:textSize="11sp"
            android:textColor="@color/wi_muted"
            android:id="@+id/tvCredit"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"/>
    </LinearLayout>
    <View
        android:id="@+id/statusStrip"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@drawable/wi_status"
        android:importantForAccessibility="no"/>
</FrameLayout>
