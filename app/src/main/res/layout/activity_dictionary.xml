<?xml version="1.0" encoding="utf-8"?>
<!-- Diksiyonaryo: violet header with the book buddy, a search field, A–Y letters, then the
     word list or one word's card. Like the website's #/diksiyonaryo.
     The violet header scrolls away with the list and slides back on any upward scroll; the
     search field and letters stay pinned at the top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tb_page_bg"
    tools:context=".ui.dictionary.DictionaryActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tb_page_bg"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

        <!-- ═══ Header (top padding and min height = status bar, set in code) ═══ -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/jc_header"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            app:layout_scrollFlags="scroll|enterAlways|exitUntilCollapsed|snap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/tb_glass"
                    android:contentDescription="@string/close"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cw_ic_back"
                    app:tint="@color/tb_on" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/lexend"
                    android:text="@string/dict_title"
                    android:textColor="@color/tb_on"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ph.basaya.app.ui.pronunciation.PronunciationBookView
                    android:id="@+id/buddy"
                    android:layout_width="80dp"
                    android:layout_height="94dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/jc_bubble"
                    android:elevation="3dp"
                    android:fontFamily="@font/quicksand_medium"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:text="@string/dict_bubble"
                    android:textColor="@color/pg_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pinned: search and letters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- ═══ Search ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/dc_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/pg_ink_soft" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@null"
                android:fontFamily="@font/be_vietnam_medium"
                android:hint="@string/dict_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text|textNoSuggestions"
                android:maxLength="60"
                android:maxLines="1"
                android:textColor="@color/pg_ink"
                android:textColorHint="@color/pg_ink_soft"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ═══ A–Y letters (Abakada order), filled in code ═══ -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:contentDescription="@string/dict_letters_cd"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lettersRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- ═══ Body ═══ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- Word list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerWords"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                tools:listitem="@layout/item_dictionary_word" />

            <!-- One word, built in code -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/detailScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/detailCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/nt_card"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="22dp" />
            </androidx.core.widget.NestedScrollView>

            <!-- Not found / error. Near the top, not centered: the body runs below the screen
                 while the header is showing. -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingTop="48dp"
                android:paddingEnd="40dp"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/nt_icon_tile"
                    android:backgroundTint="@color/pg_pagsusulit_tint">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_dictionary"
                        app:tint="@color/pg_pagsusulit" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/lexend"
                    android:gravity="center"
                    android:textColor="@color/pg_ink"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="@string/dict_empty_title" />

                <TextView
                    android:id="@+id/tvEmptyBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/quicksand_medium"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/pg_ink_soft"
                    android:textSize="14sp"
                    tools:text="@string/dict_empty_body" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:indeterminateTint="@color/pg_pagsusulit"
                android:visibility="gone" />
        </FrameLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- Wiktionary credit (CC BY-SA asks for it); bottom padding = nav bar, set in code -->
        <TextView
            android:id="@+id/tvCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/public_sans"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingTop="6dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp"
            android:text="@string/dict_credit"
            android:textColor="@color/pg_ink_soft"
            android:textSize="11sp"
            tools:ignore="SmallSp" />
    </LinearLayout>

    <!-- Covers the status bar once the header scrolls under it; height and fade set in code -->
    <View
        android:id="@+id/statusStrip"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@drawable/dc_status_strip"
        android:importantForAccessibility="no" />
</FrameLayout>
