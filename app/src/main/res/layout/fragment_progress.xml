<?xml version="1.0" encoding="utf-8"?>
<!-- Student progress: buddy hero, five separate skill cards, and words to practice. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pg_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.fragment.ProgressFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="@font/lexend"
            android:text="@string/pg_title"
            android:textColor="@color/pg_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/quicksand_medium"
            android:text="@string/pg_subtitle"
            android:textColor="@color/pg_ink_soft"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- ═══ Hero: buddy + greeting + lessons finished ═══ -->
        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/pg_hero"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <ph.basaya.app.ui.pronunciation.PronunciationBookView
                android:id="@+id/buddy"
                android:layout_width="92dp"
                android:layout_height="108dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend"
                    android:text="@string/pg_greeting_plain"
                    android:textColor="@color/pg_ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/quicksand_medium"
                    android:lineSpacingExtra="1dp"
                    android:textColor="@color/pg_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Ang galing mo! Tingnan ang mga bituing nakuha mo." />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/lessonRing"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pg_circle"
                android:backgroundTint="@color/pg_surface">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressLessons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:max="100"
                    app:indicatorColor="@color/pg_talasalitaan"
                    app:indicatorSize="72dp"
                    app:trackColor="@color/pg_track"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="7dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLessonsDone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend"
                        android:textColor="@color/pg_ink"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="8/10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_medium"
                        android:gravity="center"
                        android:lineSpacingMultiplier="0.85"
                        android:text="@string/pg_lessons_label"
                        android:textColor="@color/pg_ink_soft"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:ignore="SmallSp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ═══ Skills ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="12dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/lexend"
            android:text="@string/pg_section_skills"
            android:textColor="@color/pg_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/skillsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical" />

        <!-- ═══ Words to practice (Pagbigkas hard words) ═══ -->
        <LinearLayout
            android:id="@+id/wordsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/pg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="21dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:drawablePadding="8dp"
                android:fontFamily="@font/lexend"
                android:gravity="center_vertical"
                android:text="@string/pg_section_words"
                android:textColor="@color/pg_ink"
                android:textSize="17sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_mic"
                app:drawableTint="@color/pg_pagbigkas" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/quicksand_medium"
                android:text="@string/pg_words_hint"
                android:textColor="@color/pg_ink_soft"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/wordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:flexWrap="wrap" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
