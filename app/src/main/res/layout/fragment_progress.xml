<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F5"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".ui.fragment.ProgressFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aking kasanayan"
            android:textColor="#172033"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="Subaybayan ang mga kasanayang natatapos mo sa bawat aralin."
            android:textColor="#667085"
            android:textSize="15sp" />

        <!-- Summary is deliberately quiet so the actual skill cards remain the focus. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="30dp"
            app:cardBackgroundColor="#223A72"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/lessonProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="19dp"
                android:paddingEnd="20dp"
                android:paddingBottom="19dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kabuuang Progreso"
                        android:textColor="#C5D2F0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLessonProgressFraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0/0 aralin natapos"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="0/2 aralin natapos" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressLessonOverall"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="#7FA0F0"
                        app:trackColor="#33487A"
                        app:trackCornerRadius="8dp"
                        app:trackThickness="8dp"
                        tools:progress="50" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvLessonProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="0%" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.08"
            android:text="MGA KASANAYAN"
            android:textColor="#667085"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Pag-unawa sa Binasa -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8EAF0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_progress_dot_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pag-unawa sa Binasa"
                            android:textColor="#172033"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvComprehensionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Hindi pa nasisimulan"
                            android:padding="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="#667085"
                            android:textSize="13sp"
                            tools:text="4 sa 6 na aralin" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvComprehensionPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#2F5FC5"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="67%" />
                </LinearLayout>

                <!-- Bind this indicator to the lesson/skill's progress when it is available. -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressComprehension"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="17dp"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="#3B6FE2"
                    app:trackColor="#E8EEFC"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="8dp"
                    tools:progress="67" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Talasalitaan -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8EAEF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_progress_dot_green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Talasalitaan"
                            android:textColor="#172033"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvVocabStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Hindi pa nasisimulan"
                            android:padding="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="#667085"
                            android:textSize="13sp"
                            tools:text="3 sa 8 na aralin" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvVocabPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#17775B"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="38%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressVocab"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="17dp"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="#1B9270"
                    app:trackColor="#E5F3EE"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="8dp"
                    tools:progress="38" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pagkilala ng Salita -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#EDE9E5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_progress_dot_orange" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pagkilala ng Salita"
                            android:textColor="#172033"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWordRecognitionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Hindi pa nasisimulan"
                            android:padding="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="#667085"
                            android:textSize="13sp"
                            tools:text="7 sa 10 na aralin" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWordRecognitionPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#B95A28"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="70%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressWordRecognition"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="17dp"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="#D16B34"
                    app:trackColor="#F8ECE4"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="8dp"
                    tools:progress="70" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pagbigkas -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#EAECF0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_progress_dot_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pagbigkas"
                            android:textColor="#172033"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPronunciationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Hindi pa nasisimulan"
                            android:textColor="#667085"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPronunciationPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#2F5FC5"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressPronunciation"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="17dp"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="#3B6FE2"
                    app:trackColor="#E8EEFC"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pagsusulit -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#EDE9E5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_progress_dot_orange" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pagsusulit"
                            android:textColor="#172033"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvQuizStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Hindi pa nasisimulan"
                            android:textColor="#667085"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQuizPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#B95A28"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressQuiz"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="17dp"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="#D16B34"
                    app:trackColor="#F8ECE4"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
