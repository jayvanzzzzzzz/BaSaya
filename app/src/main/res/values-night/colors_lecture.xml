<?xml version="1.0" encoding="utf-8"?>
<!-- Lecture screen (dark, "Night Sky"): a bedtime storybook, indigo pages lit by a gold reading lamp. -->
<resources>
    <color name="lecture_bg_top">#141A3F</color>
    <color name="lecture_bg_bottom">@color/ns_bg</color>
    <color name="lecture_ink">@color/ns_ink</color>
    <color name="lecture_ink_soft">@color/ns_ink_soft</color>
    <color name="lecture_primary">#5B7CFF</color>
    <color name="lecture_primary_pressed">#4A68E0</color>
    <color name="lecture_paper">@color/ns_surface</color>
    <color name="lecture_paper_stroke">@color/ns_stroke</color>
    <color name="lecture_highlight">#3D3418</color>
    <color name="lecture_highlight_edge">@color/ns_gold</color>
    <color name="lecture_progress_track">@color/ns_track</color>
    <color name="lecture_button_surface">@color/ns_surface_raised</color>
    <color name="lecture_button_stroke">@color/ns_stroke</color>
    <color name="lecture_ripple">#408EA2FF</color>
    <!-- Read-along: the soft pill that glides behind the word being spoken (ReadAlongTextView). -->
    <color name="lecture_bubble">#3A3870</color>
    <color name="lecture_bubble_end">#2E4372</color>
    <color name="lecture_bubble_stroke">#6E66C8</color>
    <color name="lecture_bubble_lip">#22204A</color>
    <color name="lecture_trail">#5A54A8</color>
    <!-- "Aalis ka na?" exit dialog -->
    <color name="lex_card">@color/ns_surface</color>
    <color name="lex_card_stroke">@color/ns_stroke</color>
    <color name="lex_card_lip">@color/ns_lip</color>
    <color name="lex_chip_bg">@color/ns_gold_tint</color>
    <color name="lex_chip_ink">@color/ns_gold</color>
    <color name="lex_dot_now">@color/ns_gold</color>
    <color name="lex_sparkle">@color/ns_gold</color>
    <color name="lex_stay_lip">#3A55C4</color>
    <color name="lex_on_stay">#FFFFFF</color>
    <color name="lex_leave">@color/ns_coral</color>
    <color name="lex_leave_face">@color/ns_surface_raised</color>
    <color name="lex_leave_lip">@color/ns_coral_tint</color>
</resources>
