<?xml version="1.0" encoding="utf-8"?>
<!-- Night stage: plum-to-navy sky, stars, glowing notes and a deep teal stage. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/pr_bg_mid"
                android:endColor="@color/pr_bg_bottom"
                android:startColor="@color/pr_bg_top" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ns_stars"
        android:gravity="top|fill_horizontal"
        android:height="300dp" />
    <item
        android:drawable="@drawable/pr_bg_decor"
        android:gravity="top|fill_horizontal"
        android:height="300dp" />
    <item
        android:drawable="@drawable/pr_bg_stage"
        android:gravity="bottom|fill_horizontal"
        android:height="250dp" />
</layer-list>
