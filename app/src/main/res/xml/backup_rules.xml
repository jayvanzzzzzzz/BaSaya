<full-backup-content>
    <!-- Firebase auth depends on a device-bound Android Keystore key.
         Exclude the session and keyset together so reinstall/transfer can create fresh keys.
         Regenerate these paths if the Firebase application ID changes. -->
    <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.W0RFRkFVTFRd+MToxNjc0NDU1ODY3NTphbmRyb2lkOjcyYjZkYjdhMzJiMzZlOTllZjE2YTY.xml" />
    <exclude domain="sharedpref" path="com.google.firebase.auth.api.crypto.W0RFRkFVTFRd+MToxNjc0NDU1ODY3NTphbmRyb2lkOjcyYjZkYjdhMzJiMzZlOTllZjE2YTY.xml" />
    <exclude domain="sharedpref" path="recent_accounts.xml" />
</full-backup-content>
